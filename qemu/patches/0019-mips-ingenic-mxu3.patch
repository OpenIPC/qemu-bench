+/* Ingenic XBurst2 MXU3 is present when the CPU model sets ASE_MXU3 in
+ * insn_flags and advertises Coprocessor 2 in Config1.C2 -- what the
+ * T40/T41 kernel's cpu-probe checks. */
+static inline bool ase_mxu3_available(CPUMIPSState *env)
+{
+    return (env->insn_flags & ASE_MXU3) &&
+           (env->CP0_Config1 & (1 << CP0C1_C2));
+}
