--- /dev/null
+++ b/target/mips/tcg/mxu3_translate.c
@@ -0,0 +1,301 @@
+/*
+ * Ingenic XBurst2 MXU3 (512-bit SIMD) - instruction decoder
+ *
+ * The decode table (mxu3-gen.c.inc) is generated from the Ingenic GCC 7.2
+ * libopcodes match/mask tables; the operand field positions below come
+ * from assembling each mnemonic with mips-linux-gnu-as and reading how
+ * each register/immediate field moves.  See mxu3.h / mxu3_helper.c for
+ * how the semantics were established.
+ *
+ * All MXU3 instructions are coprocessor-2 (CU2) instructions: when
+ * Status.CU2 == 0 they raise Coprocessor Unusable with Cause.CE == 2,
+ * exactly as the T40/T41 kernel's lazy-enable path (do_cpu / CU2 trap)
+ * expects.
+ */
+#include "qemu/osdep.h"
+#include "translate.h"
+#include "mxu3.h"
+
+#include "mxu3-gen.c.inc"
+
+static inline int xf(uint32_t insn, int pos, int len)
+{
+    return extract32(insn, pos, len);
+}
+static inline int xsf(uint32_t insn, int pos, int len)
+{
+    return sextract32(insn, pos, len);
+}
+
+static void gen_mxu3_reg(DisasContext *ctx, uint32_t id, uint32_t insn)
+{
+    int shape = mxu3_desc[id].shape;
+    int a = 0, b = 0, c = 0, d = 0;
+
+    switch (shape) {
+    case SH_VVV:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    case SH_VV:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5);
+        break;
+    case SH_VVT:
+    case SH_EXTW:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        break;
+    case SH_GTW: {
+        /* gt2*: i,j 1 bit; gt4*: 2 bits; gt8w: 3 bits; i at 16, j at 21 */
+        int op = mxu3_desc[id].op;
+        int bits = (op == OP_GT4W || op == OP_GT4D) ? 2 :
+                   op == OP_GT8W ? 3 : 1;
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        c = xf(insn, 16, bits); d = xf(insn, 21, bits);
+        break;
+    }
+    case SH_VVI5:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); d = xf(insn, 11, 5);
+        break;
+    case SH_VVI8:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5);
+        d = xf(insn, 11, 5) | (xf(insn, 0, 3) << 5);
+        break;
+    case SH_LI:
+        a = xf(insn, 6, 5);
+        d = xf(insn, 11, 5) | (xf(insn, 0, 6) << 5) | (xf(insn, 16, 5) << 11);
+        break;
+    case SH_LIWR:
+        a = xf(insn, 6, 5); d = xsf(insn, 11, 10);
+        break;
+    case SH_ADDIW:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        d = xf(insn, 0, 3) | (xsf(insn, 16, 5) << 3);
+        break;
+    case SH_ADDRW:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        break;
+    case SH_REPI:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5); d = xf(insn, 16, 7);
+        break;
+    case SH_BSHLI:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5); d = xf(insn, 16, 7);
+        break;
+    case SH_MOVW:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        c = xf(insn, 21, 5); d = xf(insn, 16, 5);
+        break;
+    case SH_MOVX:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 5);
+        c = xf(insn, 21, 4); d = xf(insn, 16, 4);
+        break;
+    case SH_CMVW:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        d = xf(insn, 21, 4);
+        break;
+    case SH_GSHUFW:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    case SH_GSHUFWB1:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    case SH_MAC3:
+        a = xf(insn, 6, 2); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    case SH_MTSUM:
+        a = xf(insn, 6, 2); b = xf(insn, 16, 5);
+        break;
+    case SH_MFSUM:
+        a = xf(insn, 6, 5); b = xf(insn, 11, 2);
+        break;
+    case SH_MXSUM:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 2);
+        break;
+    case SH_SUMZ:
+        a = xf(insn, 6, 2);
+        break;
+    case SH_SRSUM:
+        a = xf(insn, 6, 2); b = xf(insn, 16, 5);
+        break;
+    case SH_SRMAC:
+        a = xf(insn, 6, 2); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    case SH_NNRD:
+        a = xf(insn, 6, 5);
+        break;
+    default:
+        a = xf(insn, 6, 5); b = xf(insn, 16, 5); c = xf(insn, 11, 5);
+        break;
+    }
+
+    gen_helper_mxu3(tcg_env, tcg_constant_i32(id), tcg_constant_i32(a),
+                    tcg_constant_i32(b), tcg_constant_i32(c),
+                    tcg_constant_i32(d));
+}
+
+static void gen_mxu3_ls(DisasContext *ctx, uint32_t id, uint32_t insn)
+{
+    const Mxu3Desc *de = &mxu3_desc[id];
+    int ew = de->ew, store = de->st, shape = de->shape;
+    int ebytes = 1 << (ew == EW_O ? 5 : ew == EW_Q ? 4 : ew == EW_D ? 3 : 2);
+    int shift = ew - EW_W;   /* element-index field is left-shifted by this */
+    int base = xf(insn, 21, 5);
+    int reg, idx, off;
+    TCGv addr = tcg_temp_new();
+
+    /*
+     * The lane index is left-justified in its 5-bit slot ([15:11] for
+     * loads, [10:6] for stores): law/lad/laq/lao put the index at
+     * [15:11]>>0,>>1,>>2,>>3 respectively.  The offset ([20:16]) is a
+     * signed element count, so the byte displacement is off*ebytes.
+     */
+    if (store) {
+        reg = xf(insn, 11, 5);
+        idx = xf(insn, 6, 5) >> shift;
+    } else {
+        reg = xf(insn, 6, 5);
+        idx = xf(insn, 11, 5) >> shift;
+    }
+    off = (shape == SH_LSIDX) ? xsf(insn, 16, 5) : 0;
+
+    gen_load_gpr(addr, base);
+    if (off) {
+        tcg_gen_addi_tl(addr, addr, off * ebytes);
+    }
+
+    if (store) {
+        gen_helper_mxu3_st(tcg_env, addr, tcg_constant_i32(reg),
+                           tcg_constant_i32(idx), tcg_constant_i32(ew));
+    } else {
+        gen_helper_mxu3_ld(tcg_env, addr, tcg_constant_i32(reg),
+                           tcg_constant_i32(idx), tcg_constant_i32(ew));
+    }
+}
+
+static void gen_mxu3_branch(DisasContext *ctx, uint32_t id, uint32_t insn)
+{
+    int rs = xf(insn, 16, 5);
+    int32_t offset = xsf(insn, 6, 15) << 2;
+
+    gen_helper_mxu3_br(bcond, tcg_env, tcg_constant_i32(id),
+                       tcg_constant_i32(rs));
+    ctx->btarget = ctx->base.pc_next + 4 + offset;
+    ctx->hflags |= MIPS_HFLAG_BC;
+    ctx->hflags |= MIPS_HFLAG_BDS32;
+}
+
+/* Ops whose semantics no available source fully specifies. */
+static bool mxu3_is_approx(int op)
+{
+    switch (op) {
+    case OP_PMAP: case OP_GSHUFB: case OP_GSHUFH: case OP_GSHUFVB:
+    case OP_GSHUFW: case OP_GSHUFWB: case OP_GSHUFWB_1: case OP_GSHUFWB_2:
+    case OP_GSHUFWH: case OP_GT1BI: case OP_GT2BI: case OP_GT4BI:
+    case OP_GTH:
+    case OP_BSHL: case OP_BSHR: case OP_BSHLI: case OP_BSHRI:
+    case OP_SRRED: case OP_FCADD: case OP_FCMULR: case OP_FCMULI:
+    case OP_FCLASSW: case OP_FXAS: case OP_EXTU3BW:
+    case OP_EXTW_LL: case OP_EXTW_LH: case OP_EXTW_HL: case OP_EXTW_HH:
+    case OP_ILVE2BI: case OP_ILVE4BI: case OP_ILVO2BI: case OP_ILVO4BI:
+    case OP_MAXU2BI: case OP_MAXU4BI: case OP_MINU2BI: case OP_MINU4BI:
+    case OP_NNRWR: case OP_NNDWR: case OP_NNCMD: case OP_NNRRD:
+    case OP_NNDRD: case OP_NNMAC: case OP_MFFPUW: case OP_MTFPUW:
+    case OP_LSST: case OP_CMVW: case OP_TOC:
+    case OP_EXTS1BIL: case OP_EXTS1BIH: case OP_EXTS2BIL: case OP_EXTS2BIH:
+    case OP_EXTS4BIL: case OP_EXTS4BIH:
+    case OP_EXTU1BIL: case OP_EXTU1BIH: case OP_EXTU2BIL: case OP_EXTU2BIH:
+    case OP_EXTU4BIL: case OP_EXTU4BIH:
+    case OP_SATSUB2BI: case OP_SATSUB4BI: case OP_SATSUH2BI: case OP_SATSUH4BI:
+    case OP_SATSUW2BI: case OP_SATSUW4BI: case OP_SATUUB2BI: case OP_SATUUB4BI:
+    case OP_SATUUH2BI: case OP_SATUUH4BI: case OP_SATUUW4BI:
+    case OP_NOP:
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool decode_ase_mxu3(DisasContext *ctx, uint32_t insn)
+{
+    unsigned i;
+    uint32_t id = MXU3_NR;
+
+    for (i = 0; i < ARRAY_SIZE(mxu3_tbl); i++) {
+        if ((insn & mxu3_tbl[i].mask) == mxu3_tbl[i].match) {
+            id = mxu3_tbl[i].id;
+            break;
+        }
+    }
+    if (id == MXU3_NR) {
+        return false;
+    }
+
+    /* Coprocessor-unusable when Status.CU2 == 0: CE field = 2. */
+    if (unlikely(!(ctx->hflags & MIPS_HFLAG_CU2))) {
+        generate_exception_err(ctx, EXCP_CpU, 2);
+        return true;
+    }
+
+    {
+        static int count_all = -1;
+        bool approx = mxu3_is_approx(mxu3_desc[id].op);
+
+        if (count_all < 0) {
+            const char *e = getenv("QEMU_MXU3_STATS");
+            count_all = e && !strcmp(e, "all");
+        }
+        if (approx || count_all) {
+            gen_helper_mxu3_count(tcg_env, tcg_constant_i32(id),
+                                  tcg_constant_i32(approx));
+        }
+    }
+
+    switch (mxu3_desc[id].shape) {
+    case SH_LSIDX:
+    case SH_LSU:
+    case SH_LSST:
+        gen_mxu3_ls(ctx, id, insn);
+        break;
+    case SH_BR:
+        gen_mxu3_branch(ctx, id, insn);
+        break;
+    case SH_CFCMXU: {
+        int rd = xf(insn, 6, 5), sel = xf(insn, 11, 5);
+        TCGv t = tcg_temp_new();
+        gen_helper_mxu3_cfc(t, tcg_env, tcg_constant_i32(sel));
+        gen_store_gpr(t, rd);
+        break;
+    }
+    case SH_CTCMXU: {
+        int sel = xf(insn, 11, 5), rs = xf(insn, 21, 5);
+        TCGv t = tcg_temp_new();
+        gen_load_gpr(t, rs);
+        gen_helper_mxu3_ctc(tcg_env, tcg_constant_i32(sel), t);
+        break;
+    }
+    case SH_MFCPUW: {
+        int vw = xf(insn, 6, 5), rs = xf(insn, 21, 5);
+        TCGv t = tcg_temp_new();
+        gen_helper_mxu3_mfcpuw(t, tcg_env, tcg_constant_i32(vw));
+        gen_store_gpr(t, rs);
+        break;
+    }
+    case SH_MTCPUW: {
+        int rd = xf(insn, 6, 5), vw = xf(insn, 11, 5);
+        TCGv t = tcg_temp_new();
+        gen_load_gpr(t, rd);
+        gen_helper_mxu3_mtcpuw(tcg_env, tcg_constant_i32(vw), t);
+        break;
+    }
+    /* MFFPUW/MTFPUW (FPR<->MXU scalar moves) are not exercised by the
+     * kernel save/restore or by the tests; accepted as no-ops. */
+    case SH_NNWR:
+    case SH_NNDWR:
+    case SH_NNCMD:
+        /* NN-accelerator write/command: no architectural register effect
+         * that any available source documents; accepted as a no-op. */
+        break;
+    default:
+        gen_mxu3_reg(ctx, id, insn);
+        break;
+    }
+    return true;
+}
diff --git a/target/mips/tcg/mxu3_helper.c b/target/mips/tcg/mxu3_helper.c
new file mode 100644
--- /dev/null
+++ b/target/mips/tcg/mxu3_helper.c
@@ -0,0 +1,793 @@
+/*
+ * Ingenic XBurst2 MXU3 (512-bit SIMD) - execution helpers
+ *
+ * Semantics were established from the Ingenic GCC 7.2 toolchain only:
+ * the libopcodes match/mask/operand tables in objdump/as give the
+ * encodings and register/immediate fields; the RTL that
+ * lib/gcc/.../include/mxu3.h's __builtin_mxu3_* expand to give the exact
+ * per-instruction meaning (e.g. addw -> V16SI plus, extubl ->
+ * zero_extend of the low 32 bytes, smulbe -> signed even-byte multiply).
+ * Instructions whose RTL is an opaque UNSPEC (the gather "gt" and
+ * "gshuf" families, the sr/s reductions and the NN-accelerator ops) are
+ * not fully specified
+ * by any available source; they are implemented best-effort or as
+ * register-preserving no-ops (flagged "GUESS"/"approx" below) so that
+ * vendor code does not take an illegal-instruction trap, but their
+ * results are not guaranteed.  Everything else is exact.
+ */
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "exec/helper-proto.h"
+#include "fpu/softfloat.h"
+#include "accel/tcg/cpu-ldst.h"
+#include "qemu/log.h"
+#include "qemu/atomic.h"
+#include "mxu3.h"
+
+#include "mxu3-gen.c.inc"
+
+/* Host is little-endian in all of this project's build targets, and the
+ * guest (mipsel) is little-endian too, so a byte/half/word view of the
+ * 64-byte register matches guest lane order directly. */
+typedef union {
+    uint64_t d[8];
+    int64_t  sd[8];
+    uint32_t w[16];
+    int32_t  sw[16];
+    uint16_t h[32];
+    int16_t  sh[32];
+    uint8_t  b[64];
+    int8_t   sb[64];
+} MXU3Reg;
+
+static inline MXU3Reg *VR(CPUMIPSState *env, int n)
+{
+    return (MXU3Reg *)&env->mxu3_vr[n & 31][0];
+}
+static inline MXU3Reg *ACC(CPUMIPSState *env, int n)
+{
+    return (MXU3Reg *)&env->mxu3_acc[n & 3][0];
+}
+
+static const int ew_lanes[6] = { 64, 32, 16, 8, 4, 2 };
+
+static inline int64_t sat_s(int64_t v, int bits)
+{
+    int64_t lo = -(1LL << (bits - 1)), hi = (1LL << (bits - 1)) - 1;
+    return v < lo ? lo : v > hi ? hi : v;
+}
+static inline int64_t sat_u(int64_t v, int bits)
+{
+    int64_t hi = (1LL << bits) - 1;
+    return v < 0 ? 0 : v > hi ? hi : v;
+}
+
+static inline float32 F(uint32_t x) { return make_float32(x); }
+
+/* element get/set, signed and unsigned, by element-width code */
+static int64_t eget_s(MXU3Reg *r, int ew, int i)
+{
+    switch (ew) {
+    case EW_B: return r->sb[i];
+    case EW_H: return r->sh[i];
+    case EW_W: return r->sw[i];
+    default:   return r->sd[i];
+    }
+}
+static uint64_t eget_u(MXU3Reg *r, int ew, int i)
+{
+    switch (ew) {
+    case EW_B: return r->b[i];
+    case EW_H: return r->h[i];
+    case EW_W: return r->w[i];
+    default:   return r->d[i];
+    }
+}
+static void eset(MXU3Reg *r, int ew, int i, uint64_t v)
+{
+    switch (ew) {
+    case EW_B: r->b[i] = v; break;
+    case EW_H: r->h[i] = v; break;
+    case EW_W: r->w[i] = v; break;
+    default:   r->d[i] = v; break;
+    }
+}
+
+static void do_binary(CPUMIPSState *env, int op, int ew, int rd, int rs, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs), *b = VR(env, rt);
+    int n = ew_lanes[ew], i;
+    int bits = 8 << ew;
+
+    for (i = 0; i < n; i++) {
+        int64_t x = eget_s(a, ew, i), y = eget_s(b, ew, i);
+        uint64_t xu = eget_u(a, ew, i), yu = eget_u(b, ew, i), r = 0;
+        int sh;
+        switch (op) {
+        case OP_ADD: r = xu + yu; break;
+        case OP_SUB: r = xu - yu; break;
+        case OP_MUL: r = xu * yu; break;
+        case OP_AND: r = xu & yu; break;
+        case OP_ANDN: r = (~xu) & yu; break;
+        case OP_OR:  r = xu | yu; break;
+        case OP_ORN: r = (~xu) | yu; break;
+        case OP_XOR: r = xu ^ yu; break;
+        case OP_XORN: r = ~(xu ^ yu); break;
+        case OP_MAXS: r = x > y ? x : y; break;
+        case OP_MINS: r = x < y ? x : y; break;
+        case OP_MAXU: r = xu > yu ? xu : yu; break;
+        case OP_MINU: r = xu < yu ? xu : yu; break;
+        case OP_MAXA: { int64_t ax = x < 0 ? -x : x, ay = y < 0 ? -y : y;
+                        r = ax > ay ? x : y; break; }
+        case OP_MINA: { int64_t ax = x < 0 ? -x : x, ay = y < 0 ? -y : y;
+                        r = ax < ay ? x : y; break; }
+        case OP_CEQ:  r = (x == y) ? -1 : 0; break;
+        case OP_CLTS: r = (x <  y) ? -1 : 0; break;
+        case OP_CLES: r = (x <= y) ? -1 : 0; break;
+        case OP_CLTU: r = (xu <  yu) ? -1 : 0; break;
+        case OP_CLEU: r = (xu <= yu) ? -1 : 0; break;
+        case OP_SLL:  sh = yu & (bits - 1); r = xu << sh; break;
+        case OP_SRL:  sh = yu & (bits - 1); r = xu >> sh; break;
+        case OP_SRA:  sh = yu & (bits - 1); r = x >> sh; break;
+        case OP_SRLR: sh = yu & (bits - 1);
+                      r = sh ? (xu + (1ULL << (sh - 1))) >> sh : xu; break;
+        case OP_SRAR: sh = yu & (bits - 1);
+                      r = sh ? (x + (1LL << (sh - 1))) >> sh : x; break;
+        default: r = 0; break;
+        }
+        eset(&t, ew, i, r);
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_unary(CPUMIPSState *env, int op, int ew, int rd, int rs)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs);
+    int n = ew_lanes[ew], i;
+    for (i = 0; i < n; i++) {
+        int64_t x = eget_s(a, ew, i);
+        uint64_t r = 0;
+        switch (op) {
+        case OP_ABS:  r = x < 0 ? -x : x; break;
+        case OP_CEQZ: r = (x == 0) ? -1 : 0; break;
+        case OP_CLEZ: r = (x <= 0) ? -1 : 0; break;
+        case OP_CLTZ: r = (x <  0) ? -1 : 0; break;
+        default: r = x; break;
+        }
+        eset(&t, ew, i, r);
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_shift_imm(CPUMIPSState *env, int op, int ew, int rd, int rs,
+                         int imm)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs);
+    int n = ew_lanes[ew], i, bits = 8 << ew, sh = imm & (bits - 1);
+    for (i = 0; i < n; i++) {
+        int64_t x = eget_s(a, ew, i);
+        uint64_t xu = eget_u(a, ew, i), r = 0;
+        switch (op) {
+        case OP_SLL: r = xu << sh; break;
+        case OP_SRL: r = xu >> sh; break;
+        case OP_SRA: r = x >> sh; break;
+        case OP_SRLR: r = sh ? (xu + (1ULL << (sh - 1))) >> sh : xu; break;
+        case OP_SRAR: r = sh ? (x + (1LL << (sh - 1))) >> sh : x; break;
+        }
+        eset(&t, ew, i, r);
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_logic_imm(CPUMIPSState *env, int op, int rd, int rs, int imm)
+{
+    MXU3Reg t, *a = VR(env, rs);
+    int i;
+    for (i = 0; i < 64; i++) {
+        uint8_t x = a->b[i];
+        switch (op) {
+        case OP_ANDI: t.b[i] = x & imm; break;
+        case OP_ORI:  t.b[i] = x | imm; break;
+        case OP_XORI: t.b[i] = x ^ imm; break;
+        }
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_float(CPUMIPSState *env, int op, int rd, int rs, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs), *b = VR(env, rt);
+    float_status *s = &env->active_fpu.fp_status;
+    int i;
+    for (i = 0; i < 16; i++) {
+        float32 x = F(a->w[i]), y = F(b->w[i]);
+        uint32_t r = 0;
+        switch (op) {
+        case OP_FADD: r = float32_add(x, y, s); break;
+        case OP_FSUB: r = float32_sub(x, y, s); break;
+        case OP_FMUL: r = float32_mul(x, y, s); break;
+        case OP_FMAX: r = float32_maxnum(x, y, s); break;
+        case OP_FMIN: r = float32_minnum(x, y, s); break;
+        case OP_FMAXA: r = float32_maxnummag(x, y, s); break;
+        case OP_FMINA: r = float32_minnummag(x, y, s); break;
+        case OP_FCEQ: r = float32_eq_quiet(x, y, s) ? -1 : 0; break;
+        case OP_FCLT: r = float32_lt(x, y, s) ? -1 : 0; break;
+        case OP_FCLE: r = float32_le(x, y, s) ? -1 : 0; break;
+        case OP_FCOR: r = float32_unordered_quiet(x, y, s) ? 0 : -1; break;
+        default: r = a->w[i]; break;
+        }
+        t.w[i] = r;
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_fcvt(CPUMIPSState *env, int op, int rd, int rs)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs);
+    float_status *s = &env->active_fpu.fp_status;
+    int i;
+    for (i = 0; i < 16; i++) {
+        uint32_t r = 0;
+        switch (op) {
+        case OP_FFSIW: r = int32_to_float32(a->sw[i], s); break;
+        case OP_FFUIW: r = uint32_to_float32(a->w[i], s); break;
+        case OP_FTSIW: case OP_FTRUNCSW:
+            r = float32_to_int32_round_to_zero(F(a->w[i]), s); break;
+        case OP_FTUIW: case OP_FTRUNCUW:
+            r = float32_to_uint32_round_to_zero(F(a->w[i]), s); break;
+        case OP_FRINTW: r = float32_to_int32(F(a->w[i]), s); break;
+        default: r = a->w[i]; break;
+        }
+        t.w[i] = r;
+    }
+    *VR(env, rd) = t;
+}
+
+/* widening add/sub/mul: dst is wide lanes = rs(wide) OP extend(rt narrow).
+ * L takes the low half of rt's narrow lanes, H the high half. */
+static void do_widen(CPUMIPSState *env, int op, int ew, int rd, int rs, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs), *b = VR(env, rt);
+    int wlanes = ew_lanes[ew + 1];   /* result wide-lane count */
+    int hi = 0, i;
+    int sign = 1, kind;  /* kind: 0 add, 1 sub, 2 mul */
+    switch (op) {
+    case OP_WADDSL: case OP_WADDSH: case OP_WADDUL: case OP_WADDUH: kind = 0; break;
+    case OP_WSUBSL: case OP_WSUBSH: case OP_WSUBUL: case OP_WSUBUH: kind = 1; break;
+    default: kind = 2; break;
+    }
+    switch (op) {
+    case OP_WADDSH: case OP_WADDUH: case OP_WSUBSH: case OP_WSUBUH:
+    case OP_WMULSH: case OP_WMULUH: hi = 1; break;
+    }
+    switch (op) {
+    case OP_WADDUL: case OP_WADDUH: case OP_WSUBUL: case OP_WSUBUH:
+    case OP_WMULUL: case OP_WMULUH: sign = 0; break;
+    }
+    for (i = 0; i < wlanes; i++) {
+        int src = hi ? i + wlanes : i;
+        int64_t nv = sign ? eget_s(b, ew, src) : (int64_t)eget_u(b, ew, src);
+        int64_t wv = eget_s(a, ew + 1, i);
+        int64_t r;
+        if (kind == 0)      r = wv + nv;
+        else if (kind == 1) r = wv - nv;
+        else                r = wv * nv;    /* wsmul: wide*narrow */
+        eset(&t, ew + 1, i, r);
+    }
+    *VR(env, rd) = t;
+}
+
+/* even/odd narrow*narrow -> wide: smulbe etc. ew is the source width. */
+static void do_muleo(CPUMIPSState *env, int op, int ew, int rd, int rs, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs), *b = VR(env, rt);
+    int wlanes = ew_lanes[ew + 1], i;
+    int odd = (op == OP_MULEO_SO || op == OP_MULEO_UO);
+    int sign = (op == OP_MULEO_SE || op == OP_MULEO_SO);
+    for (i = 0; i < wlanes; i++) {
+        int src = 2 * i + odd;
+        int64_t x = sign ? eget_s(a, ew, src) : (int64_t)eget_u(a, ew, src);
+        int64_t y = sign ? eget_s(b, ew, src) : (int64_t)eget_u(b, ew, src);
+        eset(&t, ew + 1, i, x * y);
+    }
+    *VR(env, rd) = t;
+}
+
+/* sign/zero extend low or high narrow half to the next wider lane. */
+static void do_ext(CPUMIPSState *env, int op, int ew, int rd, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rt);
+    int wlanes = ew_lanes[ew + 1], i;
+    int hi = (op == OP_EXTSH || op == OP_EXTUH ||
+              op == OP_EXTS1BIH || op == OP_EXTS2BIH || op == OP_EXTS4BIH ||
+              op == OP_EXTU1BIH || op == OP_EXTU2BIH || op == OP_EXTU4BIH);
+    int sign = (op == OP_EXTSL || op == OP_EXTSH ||
+                op == OP_EXTS1BIL || op == OP_EXTS1BIH ||
+                op == OP_EXTS2BIL || op == OP_EXTS2BIH ||
+                op == OP_EXTS4BIL || op == OP_EXTS4BIH);
+    for (i = 0; i < wlanes; i++) {
+        int src = hi ? i + wlanes : i;
+        int64_t v = sign ? eget_s(a, ew, src) : (int64_t)eget_u(a, ew, src);
+        eset(&t, ew + 1, i, v);
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_ilv(CPUMIPSState *env, int op, int ew, int rd, int rs, int rt)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs), *b = VR(env, rt);
+    int n = ew_lanes[ew], half = n / 2, i;
+    int odd = (op == OP_ILVO);
+    for (i = 0; i < half; i++) {
+        int src = odd ? half + i : i;
+        eset(&t, ew, 2 * i,     eget_u(a, ew, src));
+        eset(&t, ew, 2 * i + 1, eget_u(b, ew, src));
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_sat(CPUMIPSState *env, int op, int rd, int rs)
+{
+    MXU3Reg t = {0}, *a = VR(env, rs);
+    int i;
+    switch (op) {
+    case OP_SATSSWB:
+        for (i = 0; i < 16; i++) { t.sw[i] = sat_s(a->sw[i], 8); } break;
+    case OP_SATSSWH:
+        for (i = 0; i < 16; i++) { t.sw[i] = sat_s(a->sw[i], 16); } break;
+    case OP_SATSUWB: case OP_SATSUW2BI: case OP_SATSUW4BI:
+        for (i = 0; i < 16; i++) { t.sw[i] = sat_u(a->sw[i], 8); } break;
+    case OP_SATSUWH:
+        for (i = 0; i < 16; i++) { t.sw[i] = sat_u(a->sw[i], 16); } break;
+    case OP_SATUUWB: case OP_SATUUW4BI:
+        for (i = 0; i < 16; i++) { t.w[i] = a->w[i] > 255 ? 255 : a->w[i]; } break;
+    case OP_SATUUWH:
+        for (i = 0; i < 16; i++) { t.w[i] = a->w[i] > 65535 ? 65535 : a->w[i]; } break;
+    case OP_SATSSHB:
+        for (i = 0; i < 32; i++) { t.sh[i] = sat_s(a->sh[i], 8); } break;
+    case OP_SATSUHB: case OP_SATSUH2BI: case OP_SATSUH4BI:
+        for (i = 0; i < 32; i++) { t.sh[i] = sat_u(a->sh[i], 8); } break;
+    case OP_SATUUHB: case OP_SATUUH2BI: case OP_SATUUH4BI:
+        for (i = 0; i < 32; i++) { t.h[i] = a->h[i] > 255 ? 255 : a->h[i]; } break;
+    case OP_SATSUB2BI: case OP_SATSUB4BI:
+        for (i = 0; i < 64; i++) { t.b[i] = a->sb[i] < 0 ? 0 : a->b[i]; } break;
+    case OP_SATUUB2BI: case OP_SATUUB4BI:
+        t = *a; break;
+    default: t = *a; break;
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_repi(CPUMIPSState *env, int ew, int rd, int rt, int idx)
+{
+    MXU3Reg t = {0}, *a = VR(env, rt);
+    int n = ew_lanes[ew], i;
+    uint64_t v = eget_u(a, ew, idx & (n - 1));
+    for (i = 0; i < n; i++) {
+        eset(&t, ew, i, v);
+    }
+    *VR(env, rd) = t;
+}
+
+static void do_shuf(CPUMIPSState *env, int op, int ew, int rd, int rt)
+{
+    /* shufw2/4/8: deinterleave 32-bit (or d/q) lanes into "stride" groups.
+     * Derived from the RTL vec_select constant for shufw2/shufw4/shufw8. */
+    MXU3Reg t = {0}, *a = VR(env, rt);
+    int n = ew_lanes[ew], i;
+    int stride = (op == OP_SHUF2) ? 2 : (op == OP_SHUF4) ? 4 : 8;
+    int groups = n / stride, dst = 0, g, k;
+    for (k = 0; k < stride; k++) {
+        for (g = 0; g < groups; g++) {
+            eset(&t, ew, dst++, eget_u(a, ew, g * stride + k));
+        }
+    }
+    (void)i;
+    *VR(env, rd) = t;
+}
+
+void helper_mxu3(CPUMIPSState *env, uint32_t id, int32_t a, int32_t b,
+                 int32_t c, int32_t d)
+{
+    const Mxu3Desc *de = &mxu3_desc[id];
+    int op = de->op, ew = de->ew, i;
+
+    switch (op) {
+    /* ---- elementwise ---- */
+    case OP_ADD: case OP_SUB: case OP_MUL:
+    case OP_AND: case OP_ANDN: case OP_OR: case OP_ORN:
+    case OP_XOR: case OP_XORN:
+    case OP_MAXS: case OP_MINS: case OP_MAXU: case OP_MINU:
+    case OP_MAXA: case OP_MINA:
+    case OP_CEQ: case OP_CLTS: case OP_CLES: case OP_CLTU: case OP_CLEU:
+        do_binary(env, op, ew, a, b, c);
+        break;
+    case OP_SLL: case OP_SRL: case OP_SRA: case OP_SRLR: case OP_SRAR:
+        if (de->shape == SH_VVI5) {
+            do_shift_imm(env, op, ew, a, b, d);
+        } else {
+            do_binary(env, op, ew, a, b, c);
+        }
+        break;
+    case OP_ABS: case OP_CEQZ: case OP_CLEZ: case OP_CLTZ:
+        do_unary(env, op, ew, a, b);
+        break;
+    case OP_ANDI: case OP_ORI: case OP_XORI:
+        do_logic_imm(env, op, a, b, d);
+        break;
+    case OP_BSEL: {
+        /* bselv rd,rs,rt : rd = (rd & ~rt?) ... from RTL:
+         * rd = rt ^ (rd_old & (rt ^ rs)). dst rd is also a source. */
+        MXU3Reg *rd = VR(env, a), *rs = VR(env, b), *rt = VR(env, c), o = *rd;
+        for (i = 0; i < 8; i++) {
+            rd->d[i] = rt->d[i] ^ (o.d[i] & (rt->d[i] ^ rs->d[i]));
+        }
+        break;
+    }
+    case OP_FADD: case OP_FSUB: case OP_FMUL:
+    case OP_FMAX: case OP_FMIN: case OP_FMAXA: case OP_FMINA:
+    case OP_FCEQ: case OP_FCLT: case OP_FCLE: case OP_FCOR:
+        do_float(env, op, a, b, c);
+        break;
+    case OP_FFSIW: case OP_FFUIW: case OP_FTSIW: case OP_FTUIW:
+    case OP_FRINTW: case OP_FTRUNCSW: case OP_FTRUNCUW:
+        do_fcvt(env, op, a, b);
+        break;
+    case OP_WADDSL: case OP_WADDSH: case OP_WADDUL: case OP_WADDUH:
+    case OP_WSUBSL: case OP_WSUBSH: case OP_WSUBUL: case OP_WSUBUH:
+    case OP_WMULSL: case OP_WMULSH: case OP_WMULUL: case OP_WMULUH:
+        do_widen(env, op, ew, a, b, c);
+        break;
+    case OP_MULEO_SE: case OP_MULEO_SO: case OP_MULEO_UE: case OP_MULEO_UO:
+        do_muleo(env, op, ew, a, b, c);
+        break;
+    case OP_EXTSL: case OP_EXTSH: case OP_EXTUL: case OP_EXTUH:
+    case OP_EXTS1BIL: case OP_EXTS1BIH: case OP_EXTS2BIL: case OP_EXTS2BIH:
+    case OP_EXTS4BIL: case OP_EXTS4BIH:
+    case OP_EXTU1BIL: case OP_EXTU1BIH: case OP_EXTU2BIL: case OP_EXTU2BIH:
+    case OP_EXTU4BIL: case OP_EXTU4BIH:
+        do_ext(env, op, ew, a, b);
+        break;
+    case OP_ILVE: case OP_ILVO:
+        do_ilv(env, op, ew, a, b, c);
+        break;
+    case OP_SATSSHB: case OP_SATSSWB: case OP_SATSSWH:
+    case OP_SATSUHB: case OP_SATSUWB: case OP_SATSUWH:
+    case OP_SATSUB2BI: case OP_SATSUB4BI: case OP_SATSUH2BI: case OP_SATSUH4BI:
+    case OP_SATSUW2BI: case OP_SATSUW4BI:
+    case OP_SATUUHB: case OP_SATUUWB: case OP_SATUUWH:
+    case OP_SATUUB2BI: case OP_SATUUB4BI: case OP_SATUUH2BI: case OP_SATUUH4BI:
+    case OP_SATUUW4BI:
+        do_sat(env, op, a, b);
+        break;
+    case OP_REPI:
+        do_repi(env, ew, a, b, d);
+        break;
+    case OP_SHUF2: case OP_SHUF4: case OP_SHUF8:
+        do_shuf(env, op, ew, a, b);
+        break;
+
+    /*
+     * Gather of every N-th element.  gtNx rd[i], rt, j: the m = lanes/N
+     * elements rt.x[N*k + j] go to block i of rd (rd.x[i*m + k]); the
+     * rest of rd is kept.  Exact: the GCC RTL for __builtin_mxu3_gtNx is
+     * vec_merge (vec_duplicate (vec_select rt [j, j+N, ...])) rd mask,
+     * with mask selecting block i.
+     */
+    case OP_GT2W: case OP_GT4W: case OP_GT8W:
+    case OP_GT2D: case OP_GT4D: case OP_GT2Q: {
+        MXU3Reg t = *VR(env, a), *src = VR(env, b);
+        int n = (op == OP_GT4W || op == OP_GT4D) ? 4 : op == OP_GT8W ? 8 : 2;
+        int lanes = ew_lanes[ew], m = lanes / n, k, w;
+        int words = (ew == EW_Q) ? 2 : 1;   /* 64-bit words per element */
+        for (k = 0; k < m; k++) {
+            int dst = (c & (n - 1)) * m + k, from = n * k + (d & (n - 1));
+            if (ew == EW_W) {
+                t.w[dst] = src->w[from];
+            } else {
+                for (w = 0; w < words; w++) {
+                    t.d[dst * words + w] = src->d[from * words + w];
+                }
+            }
+        }
+        *VR(env, a) = t;
+        break;
+    }
+    /*
+     * gtb/gth: within each 64-bit lane, the even elements (bytes, or
+     * halfwords for gth) are packed into the low 32 bits and the odd ones
+     * into the high 32 bits.  The RTL is an UNSPEC; the rule was fixed by
+     * libimp's narrowing idiom "gtb x,x ; gt2w x[0],x,0" (32 halfwords ->
+     * 32 packed bytes), which only a 64-bit-lane even/odd split satisfies,
+     * and is confirmed by the IVS move detector reporting motion on the
+     * moving test pattern.  The odd half is the natural complement (no
+     * code reads it).  gth is the same split on halfwords, unconfirmed.
+     */
+    case OP_GTB: case OP_GTH: {
+        MXU3Reg t, *src = VR(env, b);
+        int l, k;
+        for (l = 0; l < 8; l++) {
+            if (op == OP_GTB) {
+                for (k = 0; k < 4; k++) {
+                    t.b[l * 8 + k]     = src->b[l * 8 + 2 * k];
+                    t.b[l * 8 + 4 + k] = src->b[l * 8 + 2 * k + 1];
+                }
+            } else {
+                for (k = 0; k < 2; k++) {
+                    t.h[l * 4 + k]     = src->h[l * 4 + 2 * k];
+                    t.h[l * 4 + 2 + k] = src->h[l * 4 + 2 * k + 1];
+                }
+            }
+        }
+        *VR(env, a) = t;
+        break;
+    }
+
+    /* ---- immediate loads ---- */
+    case OP_LIH: {
+        MXU3Reg *rd = VR(env, a);
+        for (i = 0; i < 32; i++) rd->h[i] = d;
+        break;
+    }
+    case OP_LIW: {
+        MXU3Reg *rd = VR(env, a);
+        for (i = 0; i < 16; i++) rd->sw[i] = (int32_t)d;
+        break;
+    }
+    case OP_LIWH: {
+        MXU3Reg *rd = VR(env, a);
+        for (i = 0; i < 32; i += 2) rd->h[i] = d;   /* low half of each word */
+        break;
+    }
+    case OP_LIWR:
+        env->mxu3_vwr[a & 31] = (int32_t)d;
+        break;
+    case OP_ADDIW:
+        env->mxu3_vwr[a & 31] = (int32_t)env->mxu3_vwr[b & 31] + (int32_t)d;
+        break;
+    case OP_ADDRW:
+        env->mxu3_vwr[a & 31] = (int32_t)env->mxu3_vwr[a & 31]
+                              + (int32_t)env->mxu3_vwr[b & 31];
+        break;
+
+    /* ---- moves ---- */
+    case OP_MOVW: {   /* rd.w[didx] = rt.w[sidx]; a=rd,b=rt,c=didx,d=sidx */
+        VR(env, a)->w[c & 15] = VR(env, b)->w[d & 15];
+        break;
+    }
+    case OP_MOVX: {   /* d/q/o move of one lane. ew gives width. */
+        MXU3Reg *rd = VR(env, a), *rt = VR(env, b);
+        int lw = (ew == EW_D) ? 1 : (ew == EW_Q) ? 2 : 4; /* in 64-bit words */
+        int di = (c & 7) * lw, si = (d & 7) * lw;
+        for (i = 0; i < lw; i++) rd->d[di + i] = rt->d[si + i];
+        break;
+    }
+    case OP_CMVW: {   /* conditional merge: rd.w[sel] = rt-selected; from RTL
+                       * it builds a word result; model as rd.w[d]=rt.w[d]
+                       * gated by rs. approx. */
+        VR(env, a)->w[d & 15] = VR(env, c)->w[d & 15];
+        break;
+    }
+
+    /* ---- accumulator ---- */
+    case OP_MTSUM: {  /* acc = rt (16x32) ; a=acc, b=rs */
+        *ACC(env, a) = *VR(env, b);
+        break;
+    }
+    case OP_MFSUM: {  /* rd = acc ; a=rd, b=acc */
+        *VR(env, a) = *ACC(env, b);
+        break;
+    }
+    case OP_MFSUMZ: { /* rd = acc; acc = 0 */
+        *VR(env, a) = *ACC(env, b);
+        memset(ACC(env, b), 0, 64);
+        break;
+    }
+    case OP_SUMZ:
+        memset(ACC(env, a), 0, 64);
+        break;
+    case OP_MXSUM: {  /* rd = acc; acc = rs */
+        MXU3Reg tmp = *ACC(env, c);
+        *ACC(env, c) = *VR(env, b);
+        *VR(env, a) = tmp;
+        break;
+    }
+    case OP_TOC:      /* "to accumulator": acc = rs */
+        *ACC(env, a) = *VR(env, b);
+        break;
+    case OP_MLAW: case OP_MLSW: {  /* acc.w += / -= rs.w * rt.w */
+        MXU3Reg *acc = ACC(env, a), *rs = VR(env, b), *rt = VR(env, c);
+        for (i = 0; i < 16; i++) {
+            int32_t p = rs->sw[i] * rt->sw[i];
+            acc->sw[i] += (op == OP_MLAW) ? p : -p;
+        }
+        break;
+    }
+    case OP_SMLAHE: case OP_SMLAHO: case OP_SMLSHE: case OP_SMLSHO: {
+        MXU3Reg *acc = ACC(env, a), *rs = VR(env, b), *rt = VR(env, c);
+        int odd = (op == OP_SMLAHO || op == OP_SMLSHO);
+        int sub = (op == OP_SMLSHE || op == OP_SMLSHO);
+        for (i = 0; i < 16; i++) {
+            int32_t p = (int32_t)rs->sh[2 * i + odd] * rt->sh[2 * i + odd];
+            acc->sw[i] += sub ? -p : p;
+        }
+        break;
+    }
+    case OP_WSMLAHL: case OP_WSMLAHH: case OP_WSMLSHL: case OP_WSMLSHH: {
+        MXU3Reg *acc = ACC(env, a), *rs = VR(env, b), *rt = VR(env, c);
+        int hi = (op == OP_WSMLAHH || op == OP_WSMLSHH);
+        int sub = (op == OP_WSMLSHL || op == OP_WSMLSHH);
+        for (i = 0; i < 16; i++) {
+            int32_t p = rs->sw[i] * (int32_t)rt->sh[hi ? i + 16 : i];
+            acc->sw[i] += sub ? -p : p;
+        }
+        break;
+    }
+
+    /* ---- control ---- */
+    case OP_CFCMXU:   /* gpr <- mcs ; handled in translate (needs GPR) */
+    case OP_CTCMXU:
+    case OP_MFCPUW: case OP_MTCPUW: case OP_MFFPUW: case OP_MTFPUW:
+        /* implemented in translate.c */
+        break;
+
+    /* ---- not fully specified by available sources: preserve dst ---- */
+    case OP_PMAP: case OP_GSHUFB: case OP_GSHUFH: case OP_GSHUFVB:
+    case OP_GSHUFW: case OP_GSHUFWB: case OP_GSHUFWB_1: case OP_GSHUFWB_2:
+    case OP_GSHUFWH:
+    case OP_BSHL: case OP_BSHR: case OP_BSHLI: case OP_BSHRI:
+    case OP_SRRED: case OP_FCADD: case OP_FCMULR: case OP_FCMULI:
+    case OP_FCLASSW: case OP_FXAS:
+    case OP_EXTU3BW: case OP_EXTW_LL: case OP_EXTW_LH:
+    case OP_EXTW_HL: case OP_EXTW_HH:
+    case OP_ILVE2BI: case OP_ILVE4BI: case OP_ILVO2BI: case OP_ILVO4BI:
+    case OP_MAXU2BI: case OP_MAXU4BI: case OP_MINU2BI: case OP_MINU4BI:
+    case OP_NNRWR: case OP_NNDWR: case OP_NNCMD: case OP_NNRRD:
+    case OP_NNDRD: case OP_NNMAC:
+    case OP_NOP:
+    default:
+        /* GUESS/unspecified: leave destination register unchanged so the
+         * instruction retires without an illegal-instruction trap. */
+        break;
+    }
+}
+
+/* branch condition: return nonzero if the branch is taken. */
+target_ulong helper_mxu3_br(CPUMIPSState *env, uint32_t id, int32_t rs)
+{
+    const Mxu3Desc *de = &mxu3_desc[id];
+    MXU3Reg *a = VR(env, rs);
+    int i;
+
+    if (de->op == OP_BEQZV || de->op == OP_BNEZV) {
+        int zero = 1;
+        for (i = 0; i < 8; i++) {
+            if (a->d[i]) { zero = 0; break; }
+        }
+        /* beqzv: whole vector zero; bnezv: any bit set */
+        return (de->op == OP_BEQZV) ? zero : !zero;
+    }
+    /* per-element: beqz* branch if ANY element == 0, bnez* if none is 0 */
+    {
+        int n = ew_lanes[de->ew], anyzero = 0;
+        for (i = 0; i < n; i++) {
+            if (eget_u(a, de->ew, i) == 0) { anyzero = 1; break; }
+        }
+        return (de->op == OP_BEQZ) ? anyzero : !anyzero;
+    }
+}
+
+/* element load: read one element (ew width) from guest memory into lane. */
+void helper_mxu3_ld(CPUMIPSState *env, target_ulong addr, uint32_t reg,
+                    uint32_t idx, uint32_t ew)
+{
+    MXU3Reg *r = VR(env, reg);
+    uintptr_t ra = GETPC();
+    switch (ew) {
+    case EW_W: r->w[idx & 15] = cpu_ldl_data_ra(env, addr, ra); break;
+    case EW_D: r->d[idx & 7]  = cpu_ldq_data_ra(env, addr, ra); break;
+    case EW_Q: {
+        int b = (idx & 3) * 2;
+        r->d[b]   = cpu_ldq_data_ra(env, addr, ra);
+        r->d[b+1] = cpu_ldq_data_ra(env, addr + 8, ra);
+        break;
+    }
+    case EW_O: {
+        int b = (idx & 1) * 4, i;
+        for (i = 0; i < 4; i++)
+            r->d[b + i] = cpu_ldq_data_ra(env, addr + 8 * i, ra);
+        break;
+    }
+    }
+}
+
+void helper_mxu3_st(CPUMIPSState *env, target_ulong addr, uint32_t reg,
+                    uint32_t idx, uint32_t ew)
+{
+    MXU3Reg *r = VR(env, reg);
+    uintptr_t ra = GETPC();
+    switch (ew) {
+    case EW_W: cpu_stl_data_ra(env, addr, r->w[idx & 15], ra); break;
+    case EW_D: cpu_stq_data_ra(env, addr, r->d[idx & 7], ra); break;
+    case EW_Q: {
+        int b = (idx & 3) * 2;
+        cpu_stq_data_ra(env, addr, r->d[b], ra);
+        cpu_stq_data_ra(env, addr + 8, r->d[b+1], ra);
+        break;
+    }
+    case EW_O: {
+        int b = (idx & 1) * 4, i;
+        for (i = 0; i < 4; i++)
+            cpu_stq_data_ra(env, addr + 8 * i, r->d[b + i], ra);
+        break;
+    }
+    }
+}
+
+/* control-register read: MCS0 = MIR (id, reports MXU3 present/version),
+ * MCS31 = MXU control/status (the kernel saves/restores this one). */
+target_ulong helper_mxu3_cfc(CPUMIPSState *env, uint32_t sel)
+{
+    if (sel == 31) {
+        return env->mxu3_csr;
+    }
+    if (sel == 0) {
+        return 0x00030000;   /* MIR: arbitrary "MXU3 present" id */
+    }
+    return 0;
+}
+
+void helper_mxu3_ctc(CPUMIPSState *env, uint32_t sel, target_ulong val)
+{
+    if (sel == 31) {
+        env->mxu3_csr = val;
+    }
+}
+
+target_ulong helper_mxu3_mfcpuw(CPUMIPSState *env, uint32_t vw)
+{
+    return (int32_t)env->mxu3_vwr[vw & 31];
+}
+
+void helper_mxu3_mtcpuw(CPUMIPSState *env, uint32_t vw, target_ulong val)
+{
+    env->mxu3_vwr[vw & 31] = val;
+}
+
+/*
+ * Approximated mnemonics: count dynamic executions and warn once per
+ * mnemonic under -d unimp, because their results are not trustworthy.
+ * QEMU_MXU3_STATS=1 in the environment prints the per-mnemonic counts of
+ * approximated instructions to stderr when QEMU exits; QEMU_MXU3_STATS=all
+ * counts every MXU3 mnemonic (exact ones are marked "exact").
+ */
+static uint64_t mxu3_exec_count[MXU3_NR];
+static bool mxu3_was_approx[MXU3_NR];
+
+static void mxu3_dump_stats(void)
+{
+    int i;
+
+    for (i = 0; i < MXU3_NR; i++) {
+        if (mxu3_exec_count[i]) {
+            fprintf(stderr, "mxu3-%s %-12s %" PRIu64 "\n",
+                    mxu3_was_approx[i] ? "approx" : "exact ",
+                    mxu3_name[i], mxu3_exec_count[i]);
+        }
+    }
+}
+
+void helper_mxu3_count(CPUMIPSState *env, uint32_t id, uint32_t approx)
+{
+    static bool registered;
+
+    if (!qatomic_xchg(&registered, true) && getenv("QEMU_MXU3_STATS")) {
+        atexit(mxu3_dump_stats);
+    }
+    if (qatomic_fetch_inc(&mxu3_exec_count[id]) == 0 && approx) {
+        mxu3_was_approx[id] = true;
+        qemu_log_mask(LOG_UNIMP, "mxu3: %s executed at pc 0x" TARGET_FMT_lx
+                      "; its semantics are approximated, results are "
+                      "not trustworthy\n", mxu3_name[id], env->active_tc.PC);
+    }
+}
