+++ b/target/mips/tcg/mxu3.h
@@ -0,0 +1,123 @@
+/*
+ * Ingenic XBurst2 MXU3 (512-bit SIMD) - shared definitions
+ *
+ * The MXU3 encodings, mnemonics and operand layouts in this file and in
+ * the generated mxu3-gen.c.inc were recovered solely from the Ingenic
+ * GCC 7.2 toolchain shipped in ingenic-t41-zeratul.7z: the libopcodes
+ * opcode table built into mips-linux-gnu-objdump/as (match/mask/operand
+ * format for every mnemonic) and the GCC MXU3 intrinsic header
+ * lib/gcc/.../include/mxu3.h plus the RTL the compiler emits for each
+ * __builtin_mxu3_* (which fixes the per-instruction semantics).  The
+ * save/restore word encodings in the T40/T41 4.4.94 kernel
+ * arch/mips/xburst2/common/mxuv3.c were used to confirm the state layout.
+ */
+#ifndef TARGET_MIPS_MXU3_H
+#define TARGET_MIPS_MXU3_H
+
+/* Operand "shape": how the raw instruction fields are laid out. */
+enum {
+    SH_VVV,     /* rd[10:6], rs[20:16], rt[15:11]            */
+    SH_VV,      /* rd[10:6], rs[20:16]                       */
+    SH_VVT,     /* rd[10:6], rt[15:11]                       */
+    SH_VVI5,    /* rd[10:6], rs[20:16], imm[15:11]           */
+    SH_VVI8,    /* rd[10:6], rs[20:16], imm{[2:0],[15:11]}   */
+    SH_LI,      /* rd[10:6], imm[20:0]                       */
+    SH_LIWR,    /* vw[10:6], imm[20:11] (signed)             */
+    SH_ADDIW,   /* vw[10:6], vw[15:11], imm{[2:0],[20:16]}   */
+    SH_ADDRW,   /* vw[10:6], vw[15:11]                       */
+    SH_REPI,    /* rd[10:6], rt[15:11], idx[20:16]           */
+    SH_BSHLI,   /* rd[10:6], rt[15:11], imm[22:16]           */
+    SH_EXTW,    /* rd[10:6], rt[15:11], hl[21]               */
+    SH_GTW,     /* rd[10:6], rt[15:11], immpack              */
+    SH_MOVW,    /* rd[10:6]+didx[25:21], rt[15:11]+sidx[20:16] */
+    SH_MOVX,    /* rd[10:6]+didx[24:21], rt[15:11]+sidx[19:16] */
+    SH_CMVW,    /* rd[10:6], rs[20:16], rt[15:11], sel[24:21] */
+    SH_GSHUFW,  /* rd[10:6], rs[20:16], rt[15:11], imm[22:21] */
+    SH_GSHUFWB1,/* rd[10:6], rs[20:16], rt[15:11], imm[21]    */
+    SH_MAC3,    /* acc[7:6], rs[20:16], rt[15:11]            */
+    SH_MTSUM,   /* acc[7:6], rs[20:16]                       */
+    SH_MFSUM,   /* rd[10:6], acc[12:11]                      */
+    SH_MXSUM,   /* rd[10:6], rs[20:16], acc[12:11]           */
+    SH_SUMZ,    /* acc[7:6]                                  */
+    SH_SRSUM,   /* acc[7:6], rs[20:16]  (reduction)          */
+    SH_SRMAC,   /* acc[7:6], rs[20:16], rt[15:11]            */
+    SH_BR,      /* rs[20:16], off[20:6]                      */
+    SH_CFCMXU,  /* gpr[10:6], mcs[15:11]                     */
+    SH_CTCMXU,  /* mcs[15:11], gpr[25:21]                    */
+    SH_MFCPUW,  /* vw[10:6], gpr[25:21]                      */
+    SH_MTCPUW,  /* gpr[10:6], vw[15:11]                      */
+    SH_MFFPUW,  /* vw[10:6], fpr[20:16]                      */
+    SH_MTFPUW,  /* fpr[10:6], vw[15:11]                      */
+    SH_NNWR,    /* vw[15:11], imm[20:6]                      */
+    SH_NNRD,    /* rd[10:6], imm[20:11]                      */
+    SH_NNDWR,   /* rt[15:11], imm[20:6]                      */
+    SH_NNCMD,   /* imm[20:6]                                 */
+    SH_LSIDX,   /* reg, idx, scaled off(base)                */
+    SH_LSU,     /* reg, idx, (base)                          */
+    SH_LSST,    /* strided (approximated)                    */
+};
+
+/* Element width codes. */
+enum { EW_B, EW_H, EW_W, EW_D, EW_Q, EW_O };
+
+/* Abstract operation; the helper switches on this. */
+enum {
+    OP_NOP,
+    OP_ADD, OP_SUB, OP_MUL, OP_AND, OP_ANDN, OP_OR, OP_ORN, OP_XOR, OP_XORN,
+    OP_ANDI, OP_ORI, OP_XORI, OP_BSEL,
+    OP_MAXS, OP_MAXU, OP_MAXA, OP_MINS, OP_MINU, OP_MINA,
+    OP_MAXU2BI, OP_MAXU4BI, OP_MINU2BI, OP_MINU4BI,
+    OP_CEQ, OP_CLES, OP_CLEU, OP_CLTS, OP_CLTU,
+    OP_CEQZ, OP_CLEZ, OP_CLTZ,
+    OP_ABS, OP_SLL, OP_SRA, OP_SRL, OP_SRAR, OP_SRLR,
+    OP_FADD, OP_FSUB, OP_FMUL, OP_FMAX, OP_FMIN, OP_FMAXA, OP_FMINA,
+    OP_FCEQ, OP_FCLE, OP_FCLT, OP_FCOR, OP_FCADD, OP_FCMULR, OP_FCMULI,
+    OP_FFSIW, OP_FFUIW, OP_FTSIW, OP_FTUIW, OP_FRINTW,
+    OP_FTRUNCSW, OP_FTRUNCUW, OP_FCLASSW, OP_FXAS,
+    OP_WADDSL, OP_WADDSH, OP_WADDUL, OP_WADDUH,
+    OP_WSUBSL, OP_WSUBSH, OP_WSUBUL, OP_WSUBUH,
+    OP_WMULSL, OP_WMULSH, OP_WMULUL, OP_WMULUH,
+    OP_MULEO_SE, OP_MULEO_SO, OP_MULEO_UE, OP_MULEO_UO,
+    OP_MLAW, OP_MLSW, OP_SMLAHE, OP_SMLAHO, OP_SMLSHE, OP_SMLSHO,
+    OP_WSMLAHL, OP_WSMLAHH, OP_WSMLSHL, OP_WSMLSHH,
+    OP_EXTSL, OP_EXTSH, OP_EXTUL, OP_EXTUH,
+    OP_EXTS1BIL, OP_EXTS1BIH, OP_EXTS2BIL, OP_EXTS2BIH, OP_EXTS4BIL, OP_EXTS4BIH,
+    OP_EXTU1BIL, OP_EXTU1BIH, OP_EXTU2BIL, OP_EXTU2BIH, OP_EXTU4BIL, OP_EXTU4BIH,
+    OP_EXTU3BW, OP_EXTW_LL, OP_EXTW_LH, OP_EXTW_HL, OP_EXTW_HH,
+    OP_ILVE, OP_ILVO, OP_ILVE2BI, OP_ILVE4BI, OP_ILVO2BI, OP_ILVO4BI,
+    OP_PMAP, OP_REPI, OP_SHUF2, OP_SHUF4, OP_SHUF8,
+    OP_SATSSHB, OP_SATSSWB, OP_SATSSWH,
+    OP_SATSUHB, OP_SATSUWB, OP_SATSUWH,
+    OP_SATSUB2BI, OP_SATSUB4BI, OP_SATSUH2BI, OP_SATSUH4BI,
+    OP_SATSUW2BI, OP_SATSUW4BI,
+    OP_SATUUHB, OP_SATUUWB, OP_SATUUWH,
+    OP_SATUUB2BI, OP_SATUUB4BI, OP_SATUUH2BI, OP_SATUUH4BI, OP_SATUUW4BI,
+    OP_TOC, OP_MTSUM, OP_MFSUM, OP_MFSUMZ, OP_SUMZ, OP_MXSUM,
+    OP_CMVW, OP_MOVW, OP_MOVX,
+    OP_LIH, OP_LIW, OP_LIWH, OP_LIWR, OP_ADDIW, OP_ADDRW,
+    OP_GT1BI, OP_GT2BI, OP_GT4BI, OP_GTB, OP_GTH,
+    OP_GT2W, OP_GT4W, OP_GT8W, OP_GT2D, OP_GT4D, OP_GT2Q,
+    OP_GSHUFB, OP_GSHUFH, OP_GSHUFVB, OP_GSHUFW, OP_GSHUFWB,
+    OP_GSHUFWB_1, OP_GSHUFWB_2, OP_GSHUFWH,
+    OP_BSHL, OP_BSHR, OP_BSHLI, OP_BSHRI,
+    OP_CFCMXU, OP_CTCMXU, OP_MFCPUW, OP_MTCPUW, OP_MFFPUW, OP_MTFPUW,
+    OP_NNRWR, OP_NNDWR, OP_NNCMD, OP_NNRRD, OP_NNDRD, OP_NNMAC,
+    OP_SRRED,
+    OP_BEQZ, OP_BNEZ, OP_BEQZV, OP_BNEZV,
+    OP_LSIDX, OP_LSU, OP_LSST,
+};
+
+typedef struct {
+    uint8_t shape;
+    uint16_t op;
+    uint8_t ew;
+    uint8_t st;    /* load/store: 1 = store */
+} Mxu3Desc;
+
+typedef struct {
+    uint32_t match;
+    uint32_t mask;
+    uint16_t id;
+} Mxu3Entry;
+
+#endif
