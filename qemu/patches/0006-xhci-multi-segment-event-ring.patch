+++ b/hw/usb/hcd-xhci.c
@@ -604,6 +604,37 @@ static inline int xhci_running(XHCIState *xhci)
     return !(xhci->usbsts & USBSTS_HCH);
 }
 
+/* The guest address of event ring entry idx, counted across the segments */
+static dma_addr_t xhci_er_addr(XHCIInterrupter *intr, unsigned int idx)
+{
+    uint32_t i;
+
+    for (i = 0; i < intr->er_nsegs; i++) {
+        if (idx < intr->er_seg_size[i]) {
+            return intr->er_seg_start[i] + TRB_SIZE * idx;
+        }
+        idx -= intr->er_seg_size[i];
+    }
+    return intr->er_start;
+}
+
+/* The entry an ERDP points at, or -1 when it is outside every segment */
+static int xhci_er_index(XHCIInterrupter *intr, dma_addr_t erdp)
+{
+    unsigned int base = 0;
+    uint32_t i;
+
+    for (i = 0; i < intr->er_nsegs; i++) {
+        dma_addr_t start = intr->er_seg_start[i];
+
+        if (erdp >= start && erdp < start + TRB_SIZE * intr->er_seg_size[i]) {
+            return base + (erdp - start) / TRB_SIZE;
+        }
+        base += intr->er_seg_size[i];
+    }
+    return -1;
+}
