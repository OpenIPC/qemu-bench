+void sdbus_set_sdio_irq(SDBus *sdbus, bool level)
+{
+    SDBusClass *sbc = SD_BUS_GET_CLASS(sdbus);
+    BusState *qbus = BUS(sdbus);
+
+    if (sbc->set_sdio_irq) {
+        sbc->set_sdio_irq(qbus->parent, level);
+    }
+}
