diff --git a/include/hw/sd/sd.h b/include/hw/sd/sd.h
index 91b5c40..b2b0366 100644
--- a/include/hw/sd/sd.h
+++ b/include/hw/sd/sd.h
@@ -81,6 +81,17 @@ typedef struct {
 } SDRequest;
 
 
+/*
+ * Any card on an SD bus.  "sdmmc-common" (SD and MMC cards) derives from
+ * it; so can a device that is not an SD/MMC card at all -- an SDIO
+ * function -- by implementing SDCardClass directly.  The bus always hands
+ * its methods an SDState pointer; a non-sdmmc card treats that as a
+ * pointer to its own instance (its DeviceState is the first member).
+ */
+#define TYPE_SD_BUS_CARD "sd-bus-card"
+#define SD_BUS_CARD_GET_CLASS(obj) \
+    OBJECT_GET_CLASS(SDCardClass, (obj), TYPE_SD_BUS_CARD)
+
 #define TYPE_SD_CARD "sd-card"
 OBJECT_DECLARE_TYPE(SDState, SDCardClass, SD_CARD)
 
@@ -154,6 +165,8 @@ struct SDBusClass {
      */
     void (*set_inserted)(DeviceState *dev, bool inserted);
     void (*set_readonly)(DeviceState *dev, bool readonly);
+    /* An SDIO card raises its interrupt to the controller through this. */
+    void (*set_sdio_irq)(DeviceState *dev, bool level);
 };
 
 /* Functions to be used by qdevified callers (working via
@@ -225,6 +238,7 @@ void sdbus_reparent_card(SDBus *from, SDBus *to);
 
 /* Functions to be used by SD devices to report back to qdevified controllers */
 void sdbus_set_inserted(SDBus *sd, bool inserted);
+void sdbus_set_sdio_irq(SDBus *sd, bool level);
 void sdbus_set_readonly(SDBus *sd, bool inserted);
 
