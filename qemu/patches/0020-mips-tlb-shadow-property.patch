mips: a "tlb-shadow" property to turn off tlbwr's shadow entries

When tlbwr replaces a TLB entry, QEMU keeps the old one as a hidden
"shadow" translation (r4k_invalidate_tlb's use_extra), which saves
QEMU TLB flushes and is invisible as long as the guest drops mappings
only through tlbp, tlbwi or tlbinv(f), which discard shadows.  The
Ingenic T40/T41 vendor 4.4 kernel, on two cores, can tell: a static
user program there now and then reads stale data through a virtual
page for the rest of its life (libm's pow() returning garbage) while
the kernel reads the right bytes for the same page.  With the shadows
off it never does.  "tlb-shadow" (default true) lets a machine turn
them off; tlbwr then discards the replaced entry as a real TLB does.

diff -ruN a/target/mips/cpu.c b/target/mips/cpu.c
--- a/target/mips/cpu.c	2026-10-30 19:13:00.666902494 +0000
+++ b/target/mips/cpu.c	2026-10-30 19:13:15.199507908 +0000
@@ -554,6 +554,7 @@
     DEFINE_PROP_UINT64("car-phys", MIPSCPU, car_phys, 0),
     DEFINE_PROP_UINT32("prid", MIPSCPU, prid, 0),
     DEFINE_PROP_UINT32("l1-kib", MIPSCPU, l1_kib, 0),
+    DEFINE_PROP_BOOL("tlb-shadow", MIPSCPU, tlb_shadow, true),
 };
 
 #ifdef CONFIG_TCG
diff -ruN a/target/mips/cpu.h b/target/mips/cpu.h
--- a/target/mips/cpu.h	2026-10-30 19:13:00.673341751 +0000
+++ b/target/mips/cpu.h	2026-10-30 19:13:15.205420521 +0000
@@ -1258,6 +1258,14 @@
      */
     uint32_t prid;
     uint32_t l1_kib;
+    /*
+     * tlbwr keeps the entry it replaces as a hidden "shadow" translation,
+     * which saves QEMU TLB flushes as long as the guest drops mappings
+     * only through tlbp/tlbwi/tlbinv(f).  false turns that off: a guest
+     * whose TLB is replaced underneath it then sees exactly what a real
+     * TLB holds.
+     */
+    bool tlb_shadow;
 };
 
 /**
diff -ruN a/target/mips/tcg/system/tlb_helper.c b/target/mips/tcg/system/tlb_helper.c
--- a/target/mips/tcg/system/tlb_helper.c	2026-10-30 19:13:00.679547344 +0000
+++ b/target/mips/tcg/system/tlb_helper.c	2026-10-30 19:13:15.211322184 +0000
@@ -164,7 +164,7 @@
 {
     int r = cpu_mips_get_random(env);
 
-    r4k_invalidate_tlb(env, r, 1);
+    r4k_invalidate_tlb(env, r, env_archcpu(env)->tlb_shadow);
     r4k_fill_tlb(env, r);
 }
 
