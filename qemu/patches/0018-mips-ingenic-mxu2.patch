diff --git a/target/mips/system/machine.c b/target/mips/system/machine.c
index 8af11fd..cb628e1 100644
--- a/target/mips/system/machine.c
+++ b/target/mips/system/machine.c
@@ -217,6 +217,38 @@ static const VMStateDescription vmstate_tlb = {
     }
 };
 
+/* Ingenic MXU2: 32 x 128-bit vector registers + MCSR, migrated as a
+ * subsection present only on a CPU that has the ASE. */
+static bool mxu2_needed(void *opaque)
+{
+    MIPSCPU *cpu = opaque;
+
+    return (cpu->env.insn_flags & ASE_MXU2) != 0;
+}
+
+static const VMStateDescription vmstate_mxu2_reg = {
+    .name = "cpu/mxu2/reg",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64_ARRAY(d, MXU2Reg, 2),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static const VMStateDescription vmstate_mxu2 = {
+    .name = "cpu/mxu2",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = mxu2_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT_ARRAY(env.mxu2.vr, MIPSCPU, 32, 1,
+                             vmstate_mxu2_reg, MXU2Reg),
+        VMSTATE_UINT32(env.mxu2.mcsr, MIPSCPU),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 /* MIPS CPU state */
 
 const VMStateDescription vmstate_mips_cpu = {
@@ -333,4 +365,8 @@ const VMStateDescription vmstate_mips_cpu = {
 
         VMSTATE_END_OF_LIST()
     },
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_mxu2,
+        NULL
+    }
 };
