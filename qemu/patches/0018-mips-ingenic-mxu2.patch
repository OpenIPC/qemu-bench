+/* ---- permute / select --------------------------------------------------- */
+
+static bool trans_SHUFV(DisasContext *ctx, arg_mxu2_4 *a)
+{
+    TCGv_ptr pd, ps, pt, pr;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    pd = tcg_temp_new_ptr();
+    ps = tcg_temp_new_ptr();
+    pt = tcg_temp_new_ptr();
+    pr = tcg_temp_new_ptr();
+    tcg_gen_addi_ptr(pd, tcg_env, mxu2_vr_off(a->vd));
+    tcg_gen_addi_ptr(ps, tcg_env, mxu2_vr_off(a->vs));
+    tcg_gen_addi_ptr(pt, tcg_env, mxu2_vr_off(a->vt));
+    tcg_gen_addi_ptr(pr, tcg_env, mxu2_vr_off(a->vr));
+    gen_helper_mxu2_shufv(pd, ps, pt, pr, tcg_constant_i32(0));
+    return true;
+}
+
+static bool trans_BSELV(DisasContext *ctx, arg_mxu2_4 *a)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    /*
+     * bselv vd, vs, vt, vr: bit-select by the mask in vr.  QEMU's bitsel
+     * computes d = (b & a) | (c & ~a) with a = mask.  GUESS (see patch
+     * description): a mask bit of 1 selects vt, 0 selects vs.
+     */
+    tcg_gen_gvec_bitsel(MO_64, mxu2_vr_off(a->vd), mxu2_vr_off(a->vr),
+                        mxu2_vr_off(a->vt), mxu2_vr_off(a->vs), 16, 16);
+    return true;
+}
+
+/* ---- element / immediate fill ------------------------------------------- */
+
+static bool trans_LI(DisasContext *ctx, arg_mxu2_li *a)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    tcg_gen_gvec_dup_imm(a->df, mxu2_vr_off(a->vd), 16, 16, (int64_t)a->imm);
+    return true;
+}
+
+static bool trans_MFCPU(DisasContext *ctx, arg_MFCPU *a)
+{
+    TCGv t;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    /* Broadcast GPR rs across all elements of size 1 << df. */
+    t = tcg_temp_new();
+    gen_load_gpr(t, a->rs);
+    tcg_gen_gvec_dup_i32(a->df, mxu2_vr_off(a->vd), 16, 16, t);
+    return true;
+}
+
+static bool trans_REPX(DisasContext *ctx, arg_REPX *a)
+{
+    TCGv_ptr pd, ps;
+    TCGv idx;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    /* Broadcast element vs[rt mod n] (index in GPR rt) across vd. */
+    pd = tcg_temp_new_ptr();
+    ps = tcg_temp_new_ptr();
+    idx = tcg_temp_new();
+    tcg_gen_addi_ptr(pd, tcg_env, mxu2_vr_off(a->vd));
+    tcg_gen_addi_ptr(ps, tcg_env, mxu2_vr_off(a->vs));
+    gen_load_gpr(idx, a->rt);
+    gen_helper_mxu2_repx(pd, ps, idx, tcg_constant_i32(a->df));
+    return true;
+}
+
+static bool trans_REPI(DisasContext *ctx, arg_REPI *a)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    tcg_gen_gvec_dup_mem(a->df, mxu2_vr_off(a->vd),
+                         mxu2_vr_off(a->vs) + mxu2_elem_ofs(a->df, a->n),
+                         16, 16);
+    return true;
+}
+
+static bool trans_INSFCPU(DisasContext *ctx, arg_INSFCPU *a)
+{
+    TCGv t;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    t = tcg_temp_new();
+    gen_load_gpr(t, a->rs);
+    switch (a->df) {
+    case 0: tcg_gen_st8_tl(t, tcg_env,
+                mxu2_vr_off(a->vd) + mxu2_elem_ofs(0, a->n)); break;
+    case 1: tcg_gen_st16_tl(t, tcg_env,
+                mxu2_vr_off(a->vd) + mxu2_elem_ofs(1, a->n)); break;
+    default: tcg_gen_st32_tl(t, tcg_env,
+                mxu2_vr_off(a->vd) + mxu2_elem_ofs(2, a->n)); break;
+    }
+    return true;
+}
+
+static bool trans_INSFMXU(DisasContext *ctx, arg_INSFMXU *a)
+{
+    TCGv t;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    /* vd[n] = vs[0] */
+    t = tcg_temp_new();
+    switch (a->df) {
+    case 0:
+        tcg_gen_ld8u_tl(t, tcg_env, mxu2_vr_off(a->vs) + mxu2_elem_ofs(0, 0));
+        tcg_gen_st8_tl(t, tcg_env, mxu2_vr_off(a->vd) + mxu2_elem_ofs(0, a->n));
+        break;
+    case 1:
+        tcg_gen_ld16u_tl(t, tcg_env, mxu2_vr_off(a->vs) + mxu2_elem_ofs(1, 0));
+        tcg_gen_st16_tl(t, tcg_env, mxu2_vr_off(a->vd) + mxu2_elem_ofs(1, a->n));
+        break;
+    case 2:
+        tcg_gen_ld32u_tl(t, tcg_env, mxu2_vr_off(a->vs) + mxu2_elem_ofs(2, 0));
+        tcg_gen_st32_tl(t, tcg_env, mxu2_vr_off(a->vd) + mxu2_elem_ofs(2, a->n));
+        break;
+    default: {
+        TCGv_i64 d = tcg_temp_new_i64();
+        tcg_gen_ld_i64(d, tcg_env, mxu2_vr_off(a->vs));
+        tcg_gen_st_i64(d, tcg_env, mxu2_vr_off(a->vd) + (a->n ? 8 : 0));
+        break;
+    }
+    }
+    return true;
+}
+
+static bool do_mtcpu(DisasContext *ctx, int df, int n, int rd, int vs, bool uns)
+{
+    TCGv t;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    if (rd == 0) {
+        return true;
+    }
+    t = cpu_gpr[rd];
+    switch (df) {
+    case 0:
+        if (uns) {
+            tcg_gen_ld8u_tl(t, tcg_env, mxu2_vr_off(vs) + mxu2_elem_ofs(0, n));
+        } else {
+            tcg_gen_ld8s_tl(t, tcg_env, mxu2_vr_off(vs) + mxu2_elem_ofs(0, n));
+        }
+        break;
+    case 1:
+        if (uns) {
+            tcg_gen_ld16u_tl(t, tcg_env, mxu2_vr_off(vs) + mxu2_elem_ofs(1, n));
+        } else {
+            tcg_gen_ld16s_tl(t, tcg_env, mxu2_vr_off(vs) + mxu2_elem_ofs(1, n));
+        }
+        break;
+    default:
+        tcg_gen_ld32u_tl(t, tcg_env, mxu2_vr_off(vs) + mxu2_elem_ofs(2, n));
+        break;
+    }
+    return true;
+}
+
+static bool trans_MTCPUS(DisasContext *ctx, arg_MTCPUS *a)
+{
+    return do_mtcpu(ctx, a->df, a->n, a->rd, a->vs, false);
+}
+static bool trans_MTCPUU(DisasContext *ctx, arg_MTCPUU *a)
+{
+    return do_mtcpu(ctx, a->df, a->n, a->rd, a->vs, true);
+}
