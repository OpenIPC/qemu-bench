diff --git a/target/mips/tcg/mxu2_ops.h b/target/mips/tcg/mxu2_ops.h
new file mode 100644
index 0000000..deb027b
--- /dev/null
+++ b/target/mips/tcg/mxu2_ops.h
@@ -0,0 +1,65 @@
+/*
+ * Ingenic MXU2: operation codes shared by mxu2_translate.c and
+ * mxu2_helper.c (passed in the gvec descriptor's data field as
+ * (op << 2) | df).
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef TARGET_MIPS_MXU2_OPS_H
+#define TARGET_MIPS_MXU2_OPS_H
+
+#if HOST_BIG_ENDIAN
+#define MXU2_H1(x)  ((x) ^ 7)
+#define MXU2_H2(x)  ((x) ^ 3)
+#define MXU2_H4(x)  ((x) ^ 1)
+#else
+#define MXU2_H1(x)  (x)
+#define MXU2_H2(x)  (x)
+#define MXU2_H4(x)  (x)
+#endif
+
+/* Byte offset of element n of size 1 << df inside an MXU2Reg. */
+static inline int mxu2_elem_ofs(int df, int n)
+{
+    int ofs = n << df;
+#if HOST_BIG_ENDIAN
+    if (df < 3) {
+        ofs ^= 8 - (1 << df);
+    }
+#endif
+    return ofs;
+}
+
+/* Integer, three operands (vd, vs, vt; vd also read by the accumulating ones) */
+enum {
+    MXU2_MAXA, MXU2_MINA, MXU2_SRAR, MXU2_SRLR,
+    MXU2_ADDA, MXU2_ADDAS, MXU2_SUBSA, MXU2_SUBUA, MXU2_SUBUS,
+    MXU2_AVES, MXU2_AVEU, MXU2_AVERS, MXU2_AVERU,
+    MXU2_DIVS, MXU2_DIVU, MXU2_MODS, MXU2_MODU, MXU2_MADD, MXU2_MSUB,
+    MXU2_DOTPS, MXU2_DOTPU, MXU2_DADDS, MXU2_DADDU, MXU2_DSUBS, MXU2_DSUBU,
+    /* Q15/Q31: df 1 = h, 2 = w */
+    MXU2_MULQ, MXU2_MULQR, MXU2_MADDQ, MXU2_MADDQR, MXU2_MSUBQ, MXU2_MSUBQR,
+};
+
+/* Integer, two operands; the immediate forms carry imm << 8 in data */
+enum {
+    MXU2_LOC, MXU2_LZC, MXU2_BCNT,
+    MXU2_SATS, MXU2_SATU, MXU2_SRARI, MXU2_SRLRI,
+};
+
+/* Floating point, three operands: df 0 = w (single), 1 = d (double) */
+enum {
+    MXU2_FADD, MXU2_FSUB, MXU2_FMUL, MXU2_FDIV, MXU2_FMADD, MXU2_FMSUB,
+    MXU2_FMAX, MXU2_FMAXA, MXU2_FMIN, MXU2_FMINA,
+    MXU2_FCOR, MXU2_FCEQ, MXU2_FCLT, MXU2_FCLE,
+    MXU2_VCVTH, MXU2_VCVTQ,
+};
+
+/* Floating point, two operands */
+enum {
+    MXU2_FSQRT, MXU2_FCLASS, MXU2_VCVTS, MXU2_VCVTU, MXU2_VCVTFS,
+    MXU2_VCVTFU, MXU2_VTRUNCS, MXU2_VTRUNCU, MXU2_VCVTR,
+    MXU2_VCVTE, MXU2_VCVTO, MXU2_VCVTQE, MXU2_VCVTQO,
+};
+
+#endif
diff --git a/target/mips/tcg/mxu2_translate.c b/target/mips/tcg/mxu2_translate.c
new file mode 100644
index 0000000..7ea45e7
--- /dev/null
+++ b/target/mips/tcg/mxu2_translate.c
@@ -0,0 +1,724 @@
+/*
+ * Ingenic MXU2 (XBurst1 T-series 128-bit SIMD) translation.
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ *
+ * MXU2 is the coprocessor-2 SIMD unit of the Ingenic XBurst1 T-series
+ * (T10..T31).  32 x 128-bit vector registers ($vr0..$vr31) plus the
+ * MCSR control register ($31), accessed through COP2 (major 0x12) and
+ * SPECIAL2 (major 0x1c) encodings.  Access traps with Coprocessor
+ * Unusable (CE = 2) when Status.CU2 = 0, which is how the 3.10 kernel
+ * enables the unit lazily (see target/mips comments and the patch
+ * description).
+ *
+ * Simple element-wise arithmetic/logic/shift/compare is emitted inline
+ * with tcg_gen_gvec_*; the rest is deferred to mxu2_helper.c.
+ */
+
+#include "qemu/osdep.h"
+#include "translate.h"
+#include "tcg/tcg-op-gvec.h"
+#include "fpu_helper.h"
+#include "mxu2_ops.h"
+
+/* LA1Q/SA1Q scale their 10-bit displacement by the 16-byte vector width. */
+static int times_16(DisasContext *ctx, int x)
+{
+    return x * 16;
+}
+
+/* decode_ase_mxu2() is declared in translate.h. */
+
+/* Generated by decodetree from mxu2.decode. */
+#include "decode-mxu2.c.inc"
+
+static inline uint32_t mxu2_vr_off(int n)
+{
+    return offsetof(CPUMIPSState, mxu2.vr) + n * sizeof(MXU2Reg);
+}
+
+/*
+ * MXU2 instructions use coprocessor 2.  Raise Coprocessor Unusable
+ * (CE = 2) when Status.CU2 is clear so the kernel's CU2 trap handler
+ * can turn the unit on for the faulting thread.
+ */
+static bool check_mxu2_enabled(DisasContext *ctx)
+{
+    if (unlikely(!(ctx->hflags & MIPS_HFLAG_CU2))) {
+        generate_exception_err(ctx, EXCP_CpU, 2);
+        return false;
+    }
+    return true;
+}
+
+/* ---- inline element-wise forms ----------------------------------------- */
+
+typedef void gvec_fn3(unsigned, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t);
+
+static bool do_gvec3(DisasContext *ctx, arg_mxu2_3 *a, gvec_fn3 *fn)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    fn(a->df, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs), mxu2_vr_off(a->vt), 16, 16);
+    return true;
+}
+
+TRANS(ADD, do_gvec3, tcg_gen_gvec_add)
+TRANS(SUB, do_gvec3, tcg_gen_gvec_sub)
+TRANS(MUL, do_gvec3, tcg_gen_gvec_mul)
+TRANS(ADDSS, do_gvec3, tcg_gen_gvec_ssadd)
+TRANS(ADDUU, do_gvec3, tcg_gen_gvec_usadd)
+TRANS(SUBSS, do_gvec3, tcg_gen_gvec_sssub)
+TRANS(SUBUU, do_gvec3, tcg_gen_gvec_ussub)
+TRANS(MAXS, do_gvec3, tcg_gen_gvec_smax)
+TRANS(MAXU, do_gvec3, tcg_gen_gvec_umax)
+TRANS(MINS, do_gvec3, tcg_gen_gvec_smin)
+TRANS(MINU, do_gvec3, tcg_gen_gvec_umin)
+TRANS(SLL, do_gvec3, tcg_gen_gvec_shlv)
+TRANS(SRA, do_gvec3, tcg_gen_gvec_sarv)
+TRANS(SRL, do_gvec3, tcg_gen_gvec_shrv)
+
+/* Vector logic: fixed byte element size (encoded df is always 0). */
+static bool do_gvecl(DisasContext *ctx, arg_mxu2_3 *a, gvec_fn3 *fn)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    fn(MO_64, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs), mxu2_vr_off(a->vt), 16, 16);
+    return true;
+}
+TRANS(ANDV, do_gvecl, tcg_gen_gvec_and)
+TRANS(ORV, do_gvecl, tcg_gen_gvec_or)
+TRANS(XORV, do_gvecl, tcg_gen_gvec_xor)
+TRANS(NORV, do_gvecl, tcg_gen_gvec_nor)
+
+static bool do_cmp(DisasContext *ctx, arg_mxu2_3 *a, TCGCond cond)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    tcg_gen_gvec_cmp(cond, a->df, mxu2_vr_off(a->vd),
+                     mxu2_vr_off(a->vs), mxu2_vr_off(a->vt), 16, 16);
+    return true;
+}
+TRANS(CEQ, do_cmp, TCG_COND_EQ)
+TRANS(CNE, do_cmp, TCG_COND_NE)
+TRANS(CLTS, do_cmp, TCG_COND_LT)
+TRANS(CLTU, do_cmp, TCG_COND_LTU)
+TRANS(CLES, do_cmp, TCG_COND_LE)
+TRANS(CLEU, do_cmp, TCG_COND_LEU)
+
+static bool do_cmpz(DisasContext *ctx, arg_mxu2_2 *a, TCGCond cond)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    tcg_gen_gvec_cmpi(cond, a->df, mxu2_vr_off(a->vd),
+                      mxu2_vr_off(a->vs), 0, 16, 16);
+    return true;
+}
+TRANS(CEQZ, do_cmpz, TCG_COND_EQ)
+TRANS(CNEZ, do_cmpz, TCG_COND_NE)
+TRANS(CLTZ, do_cmpz, TCG_COND_LT)
+TRANS(CLEZ, do_cmpz, TCG_COND_LE)
+
+typedef void gvec_shi(unsigned, uint32_t, uint32_t, int64_t, uint32_t, uint32_t);
+static bool do_shifti(DisasContext *ctx, arg_mxu2_i *a, gvec_shi *fn)
+{
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    fn(a->df, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs),
+       a->imm & ((8 << a->df) - 1), 16, 16);
+    return true;
+}
+TRANS(SLLI, do_shifti, tcg_gen_gvec_shli)
+TRANS(SRAI, do_shifti, tcg_gen_gvec_sari)
+TRANS(SRLI, do_shifti, tcg_gen_gvec_shri)
+
+/* Byte-immediate logic (andib/orib/xorib/norib): splat imm to all bytes. */
+static bool do_logi(DisasContext *ctx, arg_mxu2_i *a, int op)
+{
+    uint64_t c;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    c = (uint8_t)a->imm;
+    switch (op) {
+    case 0: tcg_gen_gvec_andi(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs),
+                              c, 16, 16); break;
+    case 1: tcg_gen_gvec_ori(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs),
+                             c, 16, 16); break;
+    case 2: tcg_gen_gvec_xori(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs),
+                              c, 16, 16); break;
+    default: /* nor: ~(vs | imm) = andc(~imm, vs) */
+        tcg_gen_gvec_andi(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vs),
+                          (uint8_t)~c, 16, 16);
+        /* then complement where imm bits are set is already folded; nor is
+         * ~(a|c); with per-byte c this equals (~a & ~c). Do it directly: */
+        tcg_gen_gvec_not(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vd), 16, 16);
+        tcg_gen_gvec_andi(MO_8, mxu2_vr_off(a->vd), mxu2_vr_off(a->vd),
+                          (uint8_t)~c, 16, 16);
+        break;
+    }
+    return true;
+}
+TRANS(ANDIB, do_logi, 0)
+TRANS(ORIB, do_logi, 1)
+TRANS(XORIB, do_logi, 2)
+TRANS(NORIB, do_logi, 3)
+
+/* ---- helper-backed integer forms --------------------------------------- */
+
+static bool do_help3(DisasContext *ctx, arg_mxu2_3 *a, int op)
+{
+    TCGv_ptr pd, ps, pt;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    pd = tcg_temp_new_ptr();
+    ps = tcg_temp_new_ptr();
+    pt = tcg_temp_new_ptr();
+    tcg_gen_addi_ptr(pd, tcg_env, mxu2_vr_off(a->vd));
+    tcg_gen_addi_ptr(ps, tcg_env, mxu2_vr_off(a->vs));
+    tcg_gen_addi_ptr(pt, tcg_env, mxu2_vr_off(a->vt));
+    gen_helper_mxu2_int3(pd, ps, pt, tcg_constant_i32((op << 2) | a->df));
+    return true;
+}
