+/* ---- loads / stores ----------------------------------------------------- */
+
+static void mxu2_ld128(DisasContext *ctx, int vd, TCGv addr)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv a2 = tcg_temp_new();
+    tcg_gen_qemu_ld_i64(t, addr, ctx->mem_idx, MO_LEUQ);
+    tcg_gen_st_i64(t, tcg_env, mxu2_vr_off(vd));
+    tcg_gen_addi_tl(a2, addr, 8);
+    tcg_gen_qemu_ld_i64(t, a2, ctx->mem_idx, MO_LEUQ);
+    tcg_gen_st_i64(t, tcg_env, mxu2_vr_off(vd) + 8);
+}
+
+static void mxu2_st128(DisasContext *ctx, int vd, TCGv addr)
+{
+    TCGv_i64 t = tcg_temp_new_i64();
+    TCGv a2 = tcg_temp_new();
+    tcg_gen_ld_i64(t, tcg_env, mxu2_vr_off(vd));
+    tcg_gen_qemu_st_i64(t, addr, ctx->mem_idx, MO_LEUQ);
+    tcg_gen_addi_tl(a2, addr, 8);
+    tcg_gen_ld_i64(t, tcg_env, mxu2_vr_off(vd) + 8);
+    tcg_gen_qemu_st_i64(t, a2, ctx->mem_idx, MO_LEUQ);
+}
+
+static bool do_ldst(DisasContext *ctx, arg_mxu2_ldst *a, bool store)
+{
+    TCGv addr;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    addr = tcg_temp_new();
+    gen_base_offset_addr(ctx, addr, a->rs, a->off);
+    if (store) {
+        mxu2_st128(ctx, a->vd, addr);
+    } else {
+        mxu2_ld128(ctx, a->vd, addr);
+    }
+    return true;
+}
+TRANS(LU1Q, do_ldst, false)
+TRANS(LA1Q, do_ldst, false)
+TRANS(SU1Q, do_ldst, true)
+TRANS(SA1Q, do_ldst, true)
+
+static bool do_ldstx(DisasContext *ctx, arg_mxu2_ldx *a, bool store)
+{
+    TCGv addr;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    addr = tcg_temp_new();
+    gen_load_gpr(addr, a->rs);
+    if (a->rt) {
+        TCGv idx = tcg_temp_new();
+        gen_load_gpr(idx, a->rt);
+        tcg_gen_add_tl(addr, addr, idx);
+    }
+    if (store) {
+        mxu2_st128(ctx, a->vd, addr);
+    } else {
+        mxu2_ld128(ctx, a->vd, addr);
+    }
+    return true;
+}
+TRANS(LU1QX, do_ldstx, false)
+TRANS(LA1QX, do_ldstx, false)
+TRANS(SU1QX, do_ldstx, true)
+TRANS(SA1QX, do_ldstx, true)
