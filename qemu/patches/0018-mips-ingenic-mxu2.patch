diff --git a/target/mips/tcg/mxu2.decode b/target/mips/tcg/mxu2.decode
new file mode 100644
index 0000000..496ca55
--- /dev/null
+++ b/target/mips/tcg/mxu2.decode
@@ -0,0 +1,196 @@
+# Ingenic MXU2 (XBurst1 T-series 128-bit SIMD) instruction set
+#
+# SPDX-License-Identifier: LGPL-2.1-or-later
+#
+# Encodings: the MXU2 opcode table (name, operand string, match, mask)
+# of the Ingenic GCC 5.4 toolchain's libopcodes, with the operand
+# fields located by assembling every form with "as -mmxu2":
+#   vd = 10:6, vs = 15:11, vt = 20:16, vr = 25:21 (4-operand forms),
+#   GPR rs (base) = 25:21, rt (index) = 20:16, rd/rs (element moves) = 15:11,
+#   FPR fs = 15:11, fd = 10:6, MXU2 control register = 10:6.
+# COP2 (major 010010) forms carry the element size in func[1:0]
+# (b, h, w, d); SPECIAL2 (major 011100) forms in bits 25:24.
+
+&mxu2_3     vd vs vt df
+&mxu2_2     vd vs df
+&mxu2_4     vd vs vt vr
+&mxu2_i     vd vs imm df
+&mxu2_li    vd imm df
+&mxu2_bz    vt off df nez
+&mxu2_ldst  vd rs off
+&mxu2_ldx   vd rs rt
+&mxu2_elm   vd vs n df
+&mxu2_gpr   vd rs n df
+&mxu2_ctl   cs rs
+
+%off10      11:s10
+%off10x16   11:s10 !function=times_16
+%off_br     6:s10
+
+@3          ...... ..... vt:5 vs:5 vd:5 .... df:2       &mxu2_3
+@3f         ...... ..... vt:5 vs:5 vd:5 ..... df:1      &mxu2_3
+@2          ...... ..... ..... vs:5 vd:5 .... df:2      &mxu2_2
+@2f         ...... ..... ..... vs:5 vd:5 ..... df:1     &mxu2_2
+@3v         ...... ..... vt:5 vs:5 vd:5 ......            &mxu2_3 df=0
+@4          ...... vr:5 vt:5 vs:5 vd:5 ......           &mxu2_4
+@sh         ...... df:2 .. imm:6 vs:5 vd:5 ......       &mxu2_i
+@i8         ...... .. imm:8 vs:5 vd:5 ......            &mxu2_i df=0
+@elm        ...... df:2 n:8 vs:5 vd:5 ......            &mxu2_elm
+@gpr        ...... df:2 n:8 rs:5 vd:5 ......            &mxu2_gpr
+@li         ...... imm:s15 vd:5 ...... &mxu2_li
+@bz         ...... df:2 nez:1 .. vt:5 .......... ......  &mxu2_bz off=%off_br
+@bzv        ...... .. nez:1 .. vt:5 .......... ......    &mxu2_bz off=%off_br df=0
+@ld         ...... rs:5 .......... vd:5 ......          &mxu2_ldst off=%off10
+@lda        ...... rs:5 .......... vd:5 ......          &mxu2_ldst off=%off10x16
+@ldx        ...... rs:5 rt:5 ..... vd:5 ......          &mxu2_ldx
+
+{
+  # ---- COP2 group 0x10: max/min, shifts by vector, compares --------------
+  MAXA        010010 10000 ..... ..... ..... 0000 ..    @3
+  MINA        010010 10000 ..... ..... ..... 0001 ..    @3
+  MAXS        010010 10000 ..... ..... ..... 0010 ..    @3
+  MINS        010010 10000 ..... ..... ..... 0011 ..    @3
+  MAXU        010010 10000 ..... ..... ..... 0100 ..    @3
+  MINU        010010 10000 ..... ..... ..... 0101 ..    @3
+  SRA         010010 10000 ..... ..... ..... 0110 ..    @3
+  SRL         010010 10000 ..... ..... ..... 0111 ..    @3
+  SRAR        010010 10000 ..... ..... ..... 1000 ..    @3
+  SRLR        010010 10000 ..... ..... ..... 1001 ..    @3
+  CEQ         010010 10000 ..... ..... ..... 1010 ..    @3
+  CNE         010010 10000 ..... ..... ..... 1011 ..    @3
+  CLTS        010010 10000 ..... ..... ..... 1100 ..    @3
+  CLTU        010010 10000 ..... ..... ..... 1101 ..    @3
+  CLES        010010 10000 ..... ..... ..... 1110 ..    @3
+  CLEU        010010 10000 ..... ..... ..... 1111 ..    @3
+
+  # ---- COP2 group 0x11: add/sub/average/sll ------------------------------
+  ADDA        010010 10001 ..... ..... ..... 0000 ..    @3
+  SUBSA       010010 10001 ..... ..... ..... 0001 ..    @3
+  ADDAS       010010 10001 ..... ..... ..... 0010 ..    @3
+  SUBUA       010010 10001 ..... ..... ..... 0011 ..    @3
+  ADDSS       010010 10001 ..... ..... ..... 0100 ..    @3
+  SUBSS       010010 10001 ..... ..... ..... 0101 ..    @3
+  ADDUU       010010 10001 ..... ..... ..... 0110 ..    @3
+  SUBUU       010010 10001 ..... ..... ..... 0111 ..    @3
+  ADD         010010 10001 ..... ..... ..... 1000 ..    @3
+  SUBUS       010010 10001 ..... ..... ..... 1001 ..    @3
+  SLL         010010 10001 ..... ..... ..... 1010 ..    @3
+  SUB         010010 10001 ..... ..... ..... 1011 ..    @3
+  AVES        010010 10001 ..... ..... ..... 1100 ..    @3
+  AVERS       010010 10001 ..... ..... ..... 1101 ..    @3
+  AVEU        010010 10001 ..... ..... ..... 1110 ..    @3
+  AVERU       010010 10001 ..... ..... ..... 1111 ..    @3
+
+  # ---- COP2 group 0x12: div/mod/mul/madd, dot products, repx -----------
+  DIVS        010010 10010 ..... ..... ..... 0000 ..    @3
+  MUL         010010 10010 ..... ..... ..... 0001 ..    @3
+  DIVU        010010 10010 ..... ..... ..... 0010 ..    @3
+  MADD        010010 10010 ..... ..... ..... 0011 ..    @3
+  MODS        010010 10010 ..... ..... ..... 0100 ..    @3
+  MSUB        010010 10010 ..... ..... ..... 0101 ..    @3
+  MODU        010010 10010 ..... ..... ..... 0110 ..    @3
+  REPX        010010 10010 rt:5 vs:5 vd:5 0111 df:2
+  DOTPS       010010 10010 ..... ..... ..... 1000 ..    @3
+  DADDS       010010 10010 ..... ..... ..... 1001 ..    @3
+  DOTPU       010010 10010 ..... ..... ..... 1010 ..    @3
+  DADDU       010010 10010 ..... ..... ..... 1011 ..    @3
+  DSUBS       010010 10010 ..... ..... ..... 1101 ..    @3
+  DSUBU       010010 10010 ..... ..... ..... 1111 ..    @3
+
+  # ---- COP2 group 0x16: bitwise ------------------------------------------
+  ANDV        010010 10110 ..... ..... ..... 111000     @3v
+  NORV        010010 10110 ..... ..... ..... 111001     @3v
+  ORV         010010 10110 ..... ..... ..... 111010     @3v
+  XORV        010010 10110 ..... ..... ..... 111011     @3v
+
+  # ---- COP2 group 0x18: floating point and Q-format ----------------------
+  FADD        010010 11000 ..... ..... ..... 00000 .    @3f
+  FSUB        010010 11000 ..... ..... ..... 00001 .    @3f
+  FMUL        010010 11000 ..... ..... ..... 00010 .    @3f
+  FDIV        010010 11000 ..... ..... ..... 00011 .    @3f
+  FMADD       010010 11000 ..... ..... ..... 00100 .    @3f
+  FMSUB       010010 11000 ..... ..... ..... 00101 .    @3f
+  VCVTH       010010 11000 ..... ..... ..... 00110 .    @3f
+  VCVTQ       010010 11000 ..... ..... ..... 00111 .    @3f
+  FCOR        010010 11000 ..... ..... ..... 01000 .    @3f
+  FCEQ        010010 11000 ..... ..... ..... 01001 .    @3f
+  FCLT        010010 11000 ..... ..... ..... 01010 .    @3f
+  FCLE        010010 11000 ..... ..... ..... 01011 .    @3f
+  FMAX        010010 11000 ..... ..... ..... 01100 .    @3f
+  FMAXA       010010 11000 ..... ..... ..... 01101 .    @3f
+  FMIN        010010 11000 ..... ..... ..... 01110 .    @3f
+  FMINA       010010 11000 ..... ..... ..... 01111 .    @3f
+  MULQ        010010 11000 ..... ..... ..... 10100 .    @3f
+  MULQR       010010 11000 ..... ..... ..... 10101 .    @3f
+  MADDQ       010010 11000 ..... ..... ..... 11000 .    @3f
+  MADDQR      010010 11000 ..... ..... ..... 11001 .    @3f
+  MSUBQ       010010 11000 ..... ..... ..... 11010 .    @3f
+  MSUBQR      010010 11000 ..... ..... ..... 11011 .    @3f
+
+  # ---- COP2 group 0x1e, bits 20:16 = 0: unary integer, mfcpu ------------
+  CEQZ        010010 11110 00000 ..... ..... 0000 ..    @2
+  CNEZ        010010 11110 00000 ..... ..... 0001 ..    @2
+  CLTZ        010010 11110 00000 ..... ..... 0010 ..    @2
+  CLEZ        010010 11110 00000 ..... ..... 0011 ..    @2
+  LOC         010010 11110 00000 ..... ..... 0100 ..    @2
+  LZC         010010 11110 00000 ..... ..... 0101 ..    @2
+  BCNT        010010 11110 00000 ..... ..... 1100 ..    @2
+  MFCPU       010010 11110 00000 rs:5 vd:5 1111 df:2
+
+  # ---- COP2 group 0x1e, bits 20:16 = 1: unary float, conversions --------
+  FSQRT       010010 11110 00001 ..... ..... 00000 .    @2f
+  FCLASS      010010 11110 00001 ..... ..... 00011 .    @2f
+  VCVTFS      010010 11110 00001 ..... ..... 00100 .    @2f
+  VCVTFU      010010 11110 00001 ..... ..... 00101 .    @2f
+  VCVTS       010010 11110 00001 ..... ..... 00110 .    @2f
+  VCVTU       010010 11110 00001 ..... ..... 00111 .    @2f
+  VTRUNCS     010010 11110 00001 ..... ..... 01010 .    @2f
+  VTRUNCU     010010 11110 00001 ..... ..... 01011 .    @2f
+  VCVTR       010010 11110 00001 ..... ..... 01110 .    @2f
+  VCVTE       010010 11110 00001 ..... ..... 10000 .    @2f
+  VCVTO       010010 11110 00001 ..... ..... 10100 .    @2f
+  VCVTQE      010010 11110 00001 ..... ..... 11000 .    @2f
+  VCVTQO      010010 11110 00001 ..... ..... 11100 .    @2f
+  CTCMXU      010010 11110 00001 rs:5 cs:5 111100       &mxu2_ctl
+  CFCMXU      010010 11110 00001 rs:5 cs:5 111101       &mxu2_ctl
+  MFFPU       010010 11110 00001 fs:5 vd:5 11111 df:1
+
+  # ---- COP2 group 0x1f: FPU element moves --------------------------------
+  INSFFPU     010010 11111 n:5 fs:5 vd:5 00000 df:1
+  MTFPU       010010 11111 n:5 vs:5 fd:5 00010 df:1
+
+  # Anything else in COP2 space: Coprocessor Unusable when CU2 = 0,
+  # Reserved Instruction otherwise.
+  COP2_OTHER  010010 --------------------------
+}
+
+# ---- SPECIAL2 forms ------------------------------------------------------
+BZ          011100 .. . 00 ..... .......... 101000      @bz
+BZV         011100 00 . 00 ..... .......... 101001      @bzv
+SATS        011100 .. 00 ...... ..... ..... 111000      @sh
+SATU        011100 .. 01 ...... ..... ..... 111000      @sh
+SLLI        011100 .. 10 ...... ..... ..... 111000      @sh
+SRAI        011100 .. 00 ...... ..... ..... 111001      @sh
+SRARI       011100 .. 01 ...... ..... ..... 111001      @sh
+SRLI        011100 .. 10 ...... ..... ..... 111001      @sh
+SRLRI       011100 .. 11 ...... ..... ..... 111001      @sh
+ANDIB       011100 00 ........ ..... ..... 110000       @i8
+NORIB       011100 01 ........ ..... ..... 110000       @i8
+ORIB        011100 10 ........ ..... ..... 110000       @i8
+XORIB       011100 11 ........ ..... ..... 110000       @i8
+SHUFV       011100 ..... ..... ..... ..... 011000       @4
+BSELV       011100 ..... ..... ..... ..... 011001       @4
+INSFCPU     011100 .. ........ ..... ..... 110001       @gpr
+INSFMXU     011100 .. ........ ..... ..... 110010       @elm
+MTCPUS      011100 df:2 n:8 rd:5 vs:5 110011
+MTCPUU      011100 df:2 n:8 rd:5 vs:5 110100
+REPI        011100 .. ........ ..... ..... 110101       @elm
+LI          011100 ............... ..... 0011 df:2      @li
+LU1Q        011100 ..... .......... ..... 010100        @ld
+SU1Q        011100 ..... .......... ..... 011100        @ld
+LA1Q        011100 ..... .......... ..... 101100        @lda
+SA1Q        011100 ..... .......... ..... 111100        @lda
+LU1QX       011100 ..... ..... 00000 ..... 000111       @ldx
+SU1QX       011100 ..... ..... 00100 ..... 000111       @ldx
+LA1QX       011100 ..... ..... 10000 ..... 000111       @ldx
+SA1QX       011100 ..... ..... 10100 ..... 000111       @ldx
