+/* ---- branches ----------------------------------------------------------- */
+
+static bool do_bz(DisasContext *ctx, int vt, int off, int df, bool nez,
+                  bool whole)
+{
+    TCGv_i64 t0, t1;
+    if (!check_mxu2_enabled(ctx)) {
+        return true;
+    }
+    if (ctx->hflags & MIPS_HFLAG_BMASK) {
+        gen_reserved_instruction(ctx);
+        return true;
+    }
+    t0 = tcg_temp_new_i64();
+    t1 = tcg_temp_new_i64();
+    tcg_gen_ld_i64(t0, tcg_env, mxu2_vr_off(vt));
+    tcg_gen_ld_i64(t1, tcg_env, mxu2_vr_off(vt) + 8);
+
+    if (whole) {
+        /* bnez1q/beqz1q: test the whole 128-bit register. */
+        tcg_gen_or_i64(t0, t0, t1);
+        tcg_gen_setcondi_i64(nez ? TCG_COND_NE : TCG_COND_EQ, t0, t0, 0);
+    } else {
+        /*
+         * per-element: branch if (nez) every element != 0, or (eqz) any
+         * element == 0 -- matching MSA BNZ/BZ and GCC's use of bnez4w as
+         * the "all lanes nonzero" guard before a vector divide.
+         */
+        uint64_t one = dup_const(df, 1);
+        uint64_t msb = one << ((8 << df) - 1);
+        TCGv_i64 z0 = tcg_temp_new_i64();
+        TCGv_i64 z1 = tcg_temp_new_i64();
+        /* z = (x - 1) & ~x & msb : nonzero in a lane that is zero */
+        tcg_gen_subi_i64(z0, t0, one);
+        tcg_gen_andc_i64(z0, z0, t0);
+        tcg_gen_andi_i64(z0, z0, msb);
+        tcg_gen_subi_i64(z1, t1, one);
+        tcg_gen_andc_i64(z1, z1, t1);
+        tcg_gen_andi_i64(z1, z1, msb);
+        tcg_gen_or_i64(t0, z0, z1);
+        /* t0 != 0  <=>  some lane is zero */
+        tcg_gen_setcondi_i64(nez ? TCG_COND_EQ : TCG_COND_NE, t0, t0, 0);
