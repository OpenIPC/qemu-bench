--- a/target/mips/tcg/op_helper.c	2026-10-30 23:46:11.256781843 +0000
+++ b/target/mips/tcg/op_helper.c	2026-10-30 23:46:23.690099313 +0000
@@ -255,6 +255,18 @@
     return (env->CP0_Config5 >> CP0C5_XNP) & 1;
 }
 
+/*
+ * Ingenic XBurst2 hardware registers: 4 is the physical address the last
+ * LL touched (the vendor kernels translate user addresses with LL + rdhwr
+ * $4); 8..12 wait for the NNA DMA's read channels 0..2 and write channels
+ * 0..1 (ingenic-nndma), which complete when started.
+ */
+target_ulong helper_rdhwr_xburst2(CPUMIPSState *env, uint32_t reg)
+{
+    check_hwrena(env, reg, GETPC());
+    return reg == 4 ? env->CP0_LLAddr : 0;
+}
+
 void helper_pmon(CPUMIPSState *env, int function)
 {
     function /= 2;
